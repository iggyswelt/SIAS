[Unit]
Description=Rheingold Autonomous Crawler
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=iggy
WorkingDirectory=/home/iggy/.openclaw/scripts
ExecStart=/usr/bin/python3 /home/iggy/.openclaw/scripts/rheingold_autonomous.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment
Environment=DB_NAME=metamaus
Environment=DB_USER=scraper

# Logging
SyslogIdentifier=rheingold-crawler

[Install]
WantedBy=multi-user.target
