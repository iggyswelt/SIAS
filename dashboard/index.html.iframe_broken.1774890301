<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🐭 metamaus Command Center - abydon.hq</title>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        /* DARK/LIGHT MODE CSS VARIABLES */
        :root {
            --bg-primary: #0a0a0a;
            --bg-secondary: #1a1a1a;
            --bg-card: rgba(26, 26, 26, 0.95);
            --text-primary: #ffffff;
            --text-secondary: #888888;
            --accent: #EAB308;
            --accent-glow: rgba(234, 179, 8, 0.5);
            --border-color: #333333;
            --success: #00ff88;
            --warning: #ffa500;
            --error: #ff4757;
            --cyber-grid: rgba(234, 179, 8, 0.03);
        }
        
        [data-theme="light"] {
            --bg-primary: #f0f0f0;
            --bg-secondary: #ffffff;
            --bg-card: rgba(255, 255, 255, 0.95);
            --text-primary: #1a1a1a;
            --text-secondary: #666666;
            --accent: #D97706;
            --accent-glow: rgba(217, 119, 6, 0.3);
            --border-color: #dddddd;
            --success: #059669;
            --warning: #f59e0b;
            --error: #dc2626;
            --cyber-grid: rgba(217, 119, 6, 0.05);
        }
        
        /* CYBER GRID BACKGROUND */
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; 
            background: var(--bg-primary); 
            color: var(--text-primary); 
            min-height: 100vh;
            background-image: 
                linear-gradient(0deg, transparent 24%, var(--cyber-grid) 25%, var(--cyber-grid) 26%, transparent 27%, transparent 74%, var(--cyber-grid) 75%, var(--cyber-grid) 76%, transparent 77%, transparent),
                linear-gradient(90deg, transparent 24%, var(--cyber-grid) 25%, var(--cyber-grid) 26%, transparent 27%, transparent 74%, var(--cyber-grid) 75%, var(--cyber-grid) 76%, transparent 77%, transparent);
            background-size: 50px 50px;
        }
        
        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(0deg, rgba(234, 179, 8, 0.02) 0px, transparent 1px, transparent 40px),
                        repeating-linear-gradient(90deg, rgba(234, 179, 8, 0.02) 0px, transparent 1px, transparent 40px);
            pointer-events: none;
            z-index: -1;
        }
        
        /* FIXED PRICE TICKER */
        .price-ticker {
            position: fixed;
            top: 0;
            right: 0;
            display: flex;
            gap: 20px;
            padding: 12px 25px;
            background: rgba(10, 10, 10, 0.95);
            border-bottom: 2px solid #EAB308;
            border-left: 2px solid #EAB308;
            border-bottom-left-radius: 15px;
            backdrop-filter: blur(10px);
            z-index: 1000;
            box-shadow: 0 5px 20px rgba(234, 179, 8, 0.2);
        }
        
        .ticker-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .ticker-icon {
            font-size: 18px;
        }
        
        .ticker-value {
            font-family: 'Courier New', monospace;
            color: #EAB308;
            font-weight: bold;
            font-size: 15px;
        }
        
        .ticker-time {
            color: #888;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            margin-left: 10px;
            padding-left: 15px;
            border-left: 1px solid #333;
        }
        
        /* HEADER */
        .header { 
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .logo-icon {
            font-size: 32px;
        }
        
        .logo-text {
            font-size: 28px;
            color: #EAB308;
            font-weight: bold;
            text-shadow: 0 0 20px rgba(234, 179, 8, 0.5);
        }
        
        .subtitle {
            font-size: 14px;
            color: #666;
            font-style: italic;
            margin-left: 42px;
        }
        
        /* TABS */
        .tabs { display: flex; background: rgba(0,0,0,0.8); border-bottom: 2px solid #EAB308; }
        .tab { padding: 15px 30px; cursor: pointer; border-bottom: 3px solid transparent; color: #888; transition: all 0.3s; }
        .tab:hover { color: #EAB308; background: rgba(234, 179, 8, 0.1); }
        .tab.active { color: #EAB308; border-bottom-color: #EAB308; text-shadow: 0 0 10px rgba(234, 179, 8, 0.5); }
        
        /* CONTENT */
        .content { padding: 20px; max-width: 1400px; margin: 0 auto; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        /* CYBER CARDS */
        .card { 
            background: rgba(26, 26, 26, 0.95); 
            border-radius: 12px; 
            padding: 20px; 
            margin-bottom: 20px; 
            border: 1px solid #333;
            transition: all 0.3s ease;
        }
        
        .card:hover {
            border-color: #EAB308;
            box-shadow: 0 0 20px rgba(234, 179, 8, 0.2);
        }
        
        .card h2 { color: #EAB308; margin-bottom: 15px; }
        
        .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; }
        
        /* Hero Stats - 6 columns */
        .metrics.hero-stats { 
            grid-template-columns: repeat(6, 1fr); 
        }
        
        @media (max-width: 1200px) {
            .metrics.hero-stats { grid-template-columns: repeat(3, 1fr); }
        }
        
        @media (max-width: 768px) {
            .metrics.hero-stats { grid-template-columns: repeat(2, 1fr); }
        }
        
        .metric-card { 
            background: rgba(0, 255, 136, 0.05); 
            padding: 20px; 
            border-radius: 8px; 
            text-align: center;
            border: 1px solid #333;
            transition: all 0.3s ease;
        }
        
        .metric-card:hover {
            border-color: #EAB308;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(234, 179, 8, 0.2);
        }
        
        .metric-value { font-size: 2em; color: #EAB308; font-weight: bold; }
        .metric-label { color: #888; font-size: 1.1em; margin-top: 5px; }
        .metric-trend { color: #666; font-size: 1.2em; }
        
        /* BUTTONS */
        .btn { 
            background: #1a1a1a; 
            color: #EAB308; 
            border: 1px solid #EAB308; 
            padding: 10px 20px; 
            border-radius: 8px; 
            cursor: pointer; 
            font-weight: bold; 
            margin-right: 10px;
            transition: all 0.3s ease;
        }
        
        .btn:hover { 
            background: #EAB308; 
            color: #000; 
            box-shadow: 0 0 20px rgba(234, 179, 8, 0.5);
        }
        
        .btn-location {
            background: #1a1a1a;
            color: #00ff88;
            border: 1px solid #444;
            padding: 6px 14px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 1.2em;
            margin-right: 6px;
            transition: all 0.3s ease;
        }
        
        .btn-location:hover {
            background: #333;
            border-color: #00ff88;
        }
        
        .btn-secondary { background: #333; color: #fff; border-color: #444; }
        .btn-secondary:hover { background: #444; border-color: #00ff88; }
        
        /* TASKBOARD */
        .taskboard { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
        .task-column { background: rgba(0, 255, 136, 0.03); border-radius: 12px; padding: 15px; border: 1px solid #333; }
        .task-column h3 { color: #00ff88; margin-bottom: 15px; }
        .task-card { background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px; margin-bottom: 10px; border-left: 3px solid #00ff88; }
        
        .demo-item { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; border-left: 3px solid #00ff88; margin-bottom: 10px; }
        .news-item { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; border-left: 3px solid #ff8800; margin-bottom: 10px; cursor: pointer; }
        .news-item:hover { background: rgba(255,255,255,0.1); }
        
        .yt-subtab { display: none; }
        
        /* MODAL */
        .modal { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 1000; align-items: center; justify-content: center; }
        .modal.active { display: flex; }
        .modal-content { background: #1a1a1a; padding: 30px; border-radius: 12px; max-width: 500px; width: 90%; border: 1px solid #EAB308; }
        
        input, select, textarea { width: 100%; padding: 10px; background: #2a2a2a; border: 1px solid #444; border-radius: 6px; color: #fff; margin-bottom: 10px; }
        input:focus, select:focus, textarea:focus { border-color: #EAB308; outline: none; }
        
        .ticker-item span { color: #EAB308; font-weight: bold; }
        .ticker-time { color: #ffd700; font-family: monospace; font-size: 16px; margin-left: 20px; padding-left: 20px; border-left: 1px solid #333; }
        .price-up { color: #00ff88 !important; }
        .price-down { color: #ff4757 !important; }
        .filter-btn { padding: 8px 16px; margin-right: 5px; background: #1a1f2e; color: #a0a0ff; border: 1px solid #00ff9d; border-radius: 5px; cursor: pointer; }
        .filter-btn:hover { background: #00ff9d; color: black; }
        #mails-table td, #mails-table th { padding: 10px; border-bottom: 1px solid #333; }
        #mails-table tr:hover { background: #1a1f2e; }
        .status-entwurf { color: #ffa500; }
        .status-bereit { color: #00ff9d; }
        .status-gesendet { color: #888; }
        
        /* NETWORK TAB STYLES */
        #network { margin-top: 0 !important; padding-top: 0 !important; }
        #network h2 { margin-top: 10px !important; }
        
        .device-grid { 
            display: grid !important; 
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)) !important; 
            gap: 20px !important; 
            padding: 15px !important;
            width: 100% !important;
            min-height: auto !important;
        }
        
        /* DEVICE CARDS - consolidated */
        .device-card { 
            background: #0f1624; 
            border: 1px solid #00ff9d33; 
            border-radius: 10px; 
            padding: 16px; 
            cursor: pointer; 
            transition: all 0.2s; 
            width: 100% !important;
            min-height: 180px !important;
            margin: 0 !important;
            box-sizing: border-box !important;
            display: inline-block !important;
            position: relative;
            z-index: 1;
        }
        .device-card:hover { 
            border-color: #00ff9d; 
            box-shadow: 0 0 25px #00ff9d60; 
            transform: scale(1.02); 
            z-index: 10; 
        }
        .device-card::before { content: none !important; }
        .device-card::after { content: none !important; }
        .card-ip { font-size: 1.2em; color: #00ff9d; font-weight: bold; }
        .card-host { color: #a0a0ff; font-size: 1.1em; }
        .card-vendor { color: #888; font-size: 1.2em; margin-top: 4px; }
        .card-mac { font-size: 1.2em; color: #a0a0ff; margin-top: 4px; }
        .card-ports { color: #ffa500; font-size: 1.1em; margin-top: 4px; }
        .card-notes { font-size: 1.2em; color: #ff9d00; margin-top: 4px; font-style: italic; }
        .status-online { color: #00ff9d; font-weight: bold; }
        .status-offline { color: #ff4d4d; font-weight: bold; }
        
        /* HIDE REDUNDANT BULLETS/DOTS */
        .device-card::before, .device-card::after,
        .tab-content::before, .tab-content::after,
        .card::before, .card::after { content: none !important; }
        
        /* NETWORK MODAL - specific overrides */
        #network-modal { 
            display: none; 
            position: fixed; 
            top: 0; left: 0; width: 100%; height: 100%; 
            background: rgba(0,0,0,0.85); 
            align-items: center; justify-content: center; 
            z-index: 9999 !important; 
        }
        #network-modal.active { display: flex; }
        
        /* NETWORK MODAL CONTENT */
        #network-modal .modal-content { 
            background: #0f1624; 
            border: 1px solid #00ff9d; 
            border-radius: 12px; 
            padding: 24px; 
            max-width: 500px; 
            width: 90%; 
            color: #e0e0ff; 
        }
        #network-modal .modal-close { 
            float: right; 
            font-size: 24px; 
            cursor: pointer; 
            color: #ff4d4d; 
            padding: 5px 10px; 
            border: 1px solid #ff4d4d; 
            border-radius: 4px; 
        }
        #network-modal .modal-close:hover { background: #ff4d4d; color: white; }
        
        /* LOG TAB STYLES */
        .log-btn {
         background: #1a1a2e;
         color: #EAB308;
         border: 1px solid #EAB308;
         padding: 8px 16px;
         margin: 4px;
         border-radius: 6px;
         cursor: pointer;
         font-size: 15px;
         transition: all 0.2s;
        }
        .log-btn:hover, .log-btn.active {
         background: #EAB308;
         color: #000;
         font-weight: bold;
        }
        .log-btn.zerberus { border-color: #4488ff; color: #4488ff; }
        .log-btn.rheingold { border-color: #ffd700; color: #ffd700; }
        .log-btn.hermes { border-color: #ff88aa; color: #ff88aa; }
        .log-btn.hestia { border-color: #aa88ff; color: #aa88ff; }
        .log-btn.orpheus { border-color: #88ffaa; color: #88ffaa; }
        .log-table td { font-size: 15px; padding: 10px 12px; }
        .log-table th { font-size: 16px; font-weight: bold; }
    </style>
</head>
<body>
    <!-- PRICE TICKER -->
    <div class="price-ticker">
        <button id="theme-toggle" onclick="toggleTheme()" style="background:none;border:none;cursor:pointer;font-size:18px;margin-right:10px;padding:5px;" title="Dark/Light Mode">🌙</button>
        <div class="ticker-item">
            <span class="ticker-icon">₿</span>
            <span id="ticker-btc" class="ticker-value">Loading...</span>
            <span id="ticker-btc-chg" class="ticker-change"></span>
        </div>
        <div class="ticker-item">
            <span class="ticker-icon">◎</span>
            <span id="ticker-sol" class="ticker-value">Loading...</span>
            <span id="ticker-sol-chg" class="ticker-change"></span>
        </div>
        <div class="ticker-item">
            <span class="ticker-icon">🥇</span>
            <span id="ticker-gold" class="ticker-value">Loading...</span>
            <span id="ticker-gold-chg" class="ticker-change"></span>
        </div>
        <div class="ticker-item">
            <span class="ticker-icon">🥈</span>
            <span id="ticker-silver" class="ticker-value">Loading...</span>
        </div>
        <div class="ticker-time" id="current-time">--:--:--</div>
    </div>
    
    <div class="header">
        <div class="logo">
            <span class="logo-icon">🐭</span>
            <span class="logo-text">metamaus Command Center</span>
        </div>
    </div>
    <div class="tabs">
        <div class="tab active" onclick="switchTab('dashboard')">📊 Dashboard</div>
        <div class="tab" onclick="switchTab('demos')">📅 Demos</div>
        <div class="tab" onclick="switchTab('tasks')">✅ Taskboard</div>
        <div class="tab" onclick="switchTab('youtube')">📺 YouTube</div>
        <div class="tab" onclick="switchTab('news')">📰 News</div>
        <div class="tab" onclick="switchTab('agents')">🤖 Agents</div>
        <div class="tab" onclick="switchTab('trading')">💹 Trading</div>
        <div class="tab" onclick="switchTab('rheingold')">🔍 Rheingold</div>
        <div class="tab" onclick="switchTab('network')">🌐 Network</div>
        <div class="tab" onclick="switchTab('mails')">📧 Mails</div>
        <div class="tab" onclick="switchTab('logs')">📋 Logs</div>
    </div>

    <div class="content">
        <!-- DASHBOARD TAB -->
        <div id="dashboard" class="tab-content active">
            <div class="card">
                <div class="metrics">
                    <div class="metric-card" onclick="switchTab('demos')">
                        <div class="metric-value" id="db-size">59 MB</div>
                        <div class="metric-label">💾 Datenbank</div>
                        <div class="metric-sub" id="db-growth" style="font-size:17px;color:#888">Lädt...</div>
                    </div>
                    <div class="metric-card" onclick="switchTab('tasks')">
                        <div class="metric-value" id="task-count">-</div>
                        <div class="metric-label">Offene Tasks</div>
                    </div>
                    <div class="metric-card" style="cursor:pointer" onclick="switchTab('logs')">
                        <div class="metric-value" id="log-count">-</div>
                        <div class="metric-label">📋 Letzte Logs</div>
                    </div>
                </div>
                
                <!-- LOGS KACHEL -->
                <div class="card" style="margin-top:15px;padding:12px">
                    <div style="font-size:17px;color:#EAB308;letter-spacing:2px;margin-bottom:10px">📋 LETZTE LOGS</div>
                    <div id="log-list" style="display:flex;flex-direction:column;gap:4px;max-height:280px;overflow-y:auto;padding-right:6px;"></div>
                    <div id="rheingold-live-widget" style="background:rgba(255,215,0,0.06);border:1px solid rgba(255,215,0,0.25);border-radius:10px;padding:14px;margin-top:10px;">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
                            <span style="font-size:17px">🦅</span>
                            <span style="font-size:17px;color:#ffd700;letter-spacing:2px;font-weight:bold">RHEINGOLD ENGINE</span>
                            <span id="rg-live-dot" style="font-size:18px">🟡</span>
                            <span id="rg-status" style="font-size:18px;font-weight:bold;color:#4ade80">Loading...</span>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px;font-size:18px">
                            <div style="background:rgba(255,255,255,0.04);padding:7px 9px;border-radius:6px;text-align:center">
                                <div id="rg-entities" style="font-size:18px;font-weight:bold;color:#22d3ee">-</div>
                                <div style="color:#64748b;font-size:17px;margin-top:1px">Entities</div>
                            </div>
                            <div style="background:rgba(255,255,255,0.04);padding:7px 9px;border-radius:6px;text-align:center">
                                <div id="rg-funding" style="font-size:18px;font-weight:bold;color:#4ade80">-</div>
                                <div style="color:#64748b;font-size:17px;margin-top:1px">Funding</div>
                            </div>
                            <div style="background:rgba(255,255,255,0.04);padding:7px 9px;border-radius:6px;text-align:center">
                                <div id="rg-findings" style="font-size:18px;font-weight:bold;color:#a78bfa">-</div>
                                <div style="color:#64748b;font-size:17px;margin-top:1px">Findings</div>
                            </div>
                            <div style="background:rgba(255,255,255,0.04);padding:7px 9px;border-radius:6px;text-align:center">
                                <div id="rg-docs" style="font-size:18px;font-weight:bold;color:#f472b6">-</div>
                                <div style="color:#64748b;font-size:17px;margin-top:1px">Docs</div>
                            </div>
                            <div style="background:rgba(255,255,255,0.04);padding:7px 9px;border-radius:6px;text-align:center">
                                <div id="rg-netzwerk" style="font-size:18px;font-weight:bold;color:#fb7185">-</div>
                                <div style="color:#64748b;font-size:17px;margin-top:1px">Netzwerk</div>
                            </div>
                            <div style="background:rgba(255,255,255,0.04);padding:7px 9px;border-radius:6px;text-align:center">
                                <div id="rg-perhour" style="font-size:18px;font-weight:bold;color:#34d399">-</div>
                                <div style="color:#64748b;font-size:17px;margin-top:1px">Ents/h</div>
                            </div>
                        </div>
                        <div id="rg-activity-mini" style="margin-top:10px;font-size:17px;max-height:90px;overflow-y:auto;color:#aaa;line-height:1.5;border-top:1px solid rgba(255,215,0,0.1);padding-top:8px">
                            <span style="color:#555"><span class="dot2">Loading</span></span>
                        </div>
                    </div>
                </div>
                
                <!-- LOG MODAL -->
                <div id="log-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:9999;align-items:center;justify-content:center;" onclick="if(event.target===this)this.style.display='none'">
                    <div style="background:#0f1a0f;border:1px solid #1a3a1a;border-radius:8px;padding:24px;max-width:600px;width:90%;position:relative;">
                        <button onclick="document.getElementById('log-modal').style.display='none'" style="position:absolute;top:12px;right:16px;background:none;border:none;color:#4ade80;font-size:20px;cursor:pointer">×</button>
                        <div style="font-size:17px;color:#4ade80;letter-spacing:2px;margin-bottom:12px">LOG DETAIL</div>
                        <div id="log-modal-text" style="font-family:monospace;font-size:20px;color:#e2e8f0;line-height:1.7;white-space:pre-wrap"></div>
                    </div>
                </div>
                
                <div class="metrics hero-stats" style="margin-top:15px">
                    <div class="metric-card">
                        <div class="metric-value" id="btc-price">-</div>
                        <div class="metric-label">₿ BTC</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" id="sol-price">-</div>
                        <div class="metric-label">◎ SOL</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" id="gold-price">-</div>
                        <div class="metric-label">🥇 Gold</div>
                        <div class="metric-trend" id="gold-trend" style="font-size:17px;margin-top:2px;">-</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" id="silver-price">-</div>
                        <div class="metric-label">🥈 Silver</div>
                        <div class="metric-trend" id="silver-trend-24h" style="font-size:17px;margin-top:2px;">-</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" id="dax-price">-</div>
                        <div class="metric-label">DAX</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" id="sp500-price">-</div>
                        <div class="metric-label">S&P 500</div>
                    </div>
                </div>
            </div>
            
            <!-- GRIDSTACK WIDGETS -->
            <div class="grid-widgets" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 20px;">
                <!-- OpenClaw Stats -->
                <div class="card">
                    <h3>🤖 OpenClaw Stats</h3>
