            <script>
            async function loadTradingDashboard() {
                try {
                    const [profit, status, perf, queue, top] = await Promise.all([
                        fetch('/api/freqtrade/profit').then(r=>r.json()).catch(()=>({})),
                        fetch('/api/freqtrade/status').then(r=>r.json()).catch(()=>[]),
                        fetch('/api/freqtrade/performance').then(r=>r.json()).catch(()=>[]),
                        fetch('/api/trading/queue').then(r=>r.json()).catch(()=>[]),
                        fetch('/api/trading/top').then(r=>r.json()).catch(()=>[])
                    ]);
                    // Queue laden
                    if (Array.isArray(queue) && queue.length > 0) {
                        document.getElementById('queue-tbody').innerHTML = queue.map(q => {
                            const statusColor = q.status === 'running' ? '#00ff88' : q.status === 'pending' ? '#ffa500' : '#888';
                            const started = q.started_at ? new Date(q.started_at).toLocaleString('de-DE') : '-';
                            return '<tr style="border-bottom:1px solid #1a1a1a;"><td style="padding:6px 8px;color:#555;">'+q.id+'</td><td style="padding:6px 8px;color:#ccc;">'+q.strategie+'</td><td style="padding:6px 8px;text-align:center;color:'+statusColor+';">● '+q.status+'</td><td style="padding:6px 8px;text-align:center;color:#888;">'+q.priority+'</td><td style="padding:6px 8px;color:#555;font-size:17px;">'+started+'</td></tr>';
                        }).join('');
                    } else {
                        document.getElementById('queue-tbody').innerHTML = '<tr><td colspan="5" style="padding:15px;color:#555;text-align:center;">Keine Jobs in Queue</td></tr>';
                    }
                    // Top Performer
                    if (Array.isArray(top) && top.length > 0) {
                        document.getElementById('leaderboard-tbody').innerHTML = top.map((t, i) => {
                            const medals = ['🥇','🥈','🥉'];
                            const color = t.profit_pct >= 0 ? '#00ff88' : '#ff4444';
                            return '<tr style="border-bottom:1px solid #1a1a1a;"><td style="padding:6px 8px;color:#888;">'+(medals[i]||(i+1))+'</td><td style="padding:6px 8px;color:#ccc;">'+t.strategie+'</td><td style="padding:6px 8px;text-align:right;color:'+color+';">'+(t.profit_pct>=0?'+':'')+t.profit_pct+'%</td><td style="padding:6px 8px;text-align:right;color:#888;">'+(t.sharpe||'-')+'</td><td style="padding:6px 8px;text-align:right;color:#ff8800;">'+(t.drawdown||'-')+'</td></tr>';
                        }).join('');
                        document.getElementById('lb-count').textContent = top.length;
                    }
                    document.getElementById('hdr-status').textContent = '✅';
                    document.getElementById('hdr-status').style.color = '#00ff88';
                    document.getElementById('hdr-uptime').textContent = 'Running';
                    const openCount = Array.isArray(status) ? status.length : 0;
                    document.getElementById('kpi-open').textContent = openCount;
                    document.getElementById('kpi-open').style.color = openCount > 0 ? '#EAB308' : '#555';
                    const pnl = profit.profit_closed_percent_sum || 0;
                    const pnlEl = document.getElementById('kpi-profit');
                    pnlEl.textContent = (pnl>=0?'+':'') + pnl.toFixed(2) + '%';
                    pnlEl.style.color = pnl>0?'#00ff88':pnl<0?'#ff4444':'#888';
                    const wr = profit.winrate ? (profit.winrate*100).toFixed(1)+'%' : '-';
                    const wrEl = document.getElementById('kpi-winrate');
                    wrEl.textContent = wr;
                    wrEl.style.color = (profit.winrate||0)>0.5?'#00ff88':'#ffa500';
                    document.getElementById('kpi-trades').textContent = profit.trade_count || 0;
                    if (Array.isArray(status) && status.length > 0) {
                        document.getElementById('open-trades-tbody').innerHTML = status.map(t => {
                            const p = t.profit_pct || 0;
                            return '<tr style="border-bottom:1px solid #1a1a1a;"><td style="padding:6px 8px;color:#ccc;">'+t.pair+'</td><td style="padding:6px 8px;text-align:right;color:'+(p>=0?'#00ff88':'#ff4444')+';">'+(p>=0?'+':'')+p.toFixed(2)+'%</td><td style="padding:6px 8px;text-align:right;color:#555;">-</td></tr>';
                        }).join('');
                    }
                    if (Array.isArray(perf) && perf.length > 0) {
                        const sorted = [...perf].sort((a,b)=>b.profit_pct-a.profit_pct);
                        document.getElementById('best-pair').innerHTML = '<strong style="color:#00ff88">'+sorted[0].pair+'</strong> '+(sorted[0].profit_pct>=0?'+':'')+sorted[0].profit_pct.toFixed(2)+'%';
                        document.getElementById('worst-pair').innerHTML = '<strong style="color:#ff4444">'+sorted[sorted.length-1].pair+'</strong> '+sorted[sorted.length-1].profit_pct.toFixed(2)+'%';
                        document.getElementById('perf-tbody').innerHTML = sorted.slice(0,8).map(t=>
                            '<tr style="border-bottom:1px solid #1a1a1a;"><td style="padding:6px 8px;color:#ccc;">'+t.pair+'</td><td style="padding:6px 8px;text-align:right;color:'+(t.profit_pct>=0?'#00ff88':'#ff4444')+';">'+(t.profit_pct>=0?'+':'')+t.profit_pct.toFixed(2)+'%</td><td style="padding:6px 8px;text-align:right;color:#555;">'+t.count+'x</td></tr>'
                        ).join('');
                    }
                    document.getElementById('ft-last-update').textContent = new Date().toLocaleTimeString('de-DE');
                } catch(e) {
                    document.getElementById('hdr-status').textContent = '❌';
                    document.getElementById('hdr-uptime').textContent = 'Freqtrade offline';
                }
            }
            loadTradingDashboard();
            setInterval(loadTradingDashboard, 60000);
            </script>
        </div>

    <!-- Task Modal -->
    <div id="task-modal" class="modal">
        <div class="modal-content">
            <h2>Task bearbeiten</h2>
            <input type="hidden" id="task-id">
            <label>Titel:</label>
            <input type="text" id="task-title" placeholder="Task Titel">
            <label>Beschreibung:</label>
            <textarea id="task-desc" placeholder="Beschreibung..."></textarea>
            <label>Status:</label>
            <select id="task-status">
                <option value="todo">To Do</option>
                <option value="in_progress">In Progress</option>
                <option value="awaiting_confirm">Awaiting Confirm</option>
                <option value="done">Done</option>
            </select>
            <label>Priorität (1-5):</label>
            <select id="task-priority">
                <option value="1">1 - Niedrig</option>
                <option value="2">2</option>
                <option value="3" selected>3 - Mittel</option>
                <option value="4">4</option>
                <option value="5">5 - Hoch</option>
            </select>
            <div style="margin-top: 20px;">
                <button class="btn" onclick="saveTask()">Speichern</button>
                <button class="btn btn-secondary" onclick="closeTaskModal()">Abbrechen</button>
            </div>
        </div>
    </div>

    <!-- NETWORK TAB -->
        <!-- RHEINGOLD TAB -->
        <div id="rheingold" class="tab-content">
            <iframe id="rheingold-frame" src="/rheingold" style="width:100%;height:calc(100vh - 180px);border:none;background:#0a0a0f"></iframe>
        </div>

    <div id="network" class="tab-content">
        <h2>🌐 Network Assets – Zerberus Scan</h2>
        <div id="network-devices-container" class="device-grid">
            <div style="grid-column: 1/-1; color: #666;">Laden...</div>
        </div>
    </div>

    <!-- NGO MAP TAB -->
    <div id="ngo_map" class="tab-content">
        <iframe src="/ngo_map" style="width:100%;height:calc(100vh - 180px);border:none;background:#0a0a0f"></iframe>
    </div>

    <!-- NETWORK MODAL -->
    <div id="network-modal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="document.getElementById('network-modal').style.display='none'">Close</span>
            <h2 id="network-modal-title"></h2>
            <div id="network-modal-body"></div>
        </div>
    </div>

    <!-- MAILS TAB -->
    <div id="mails" class="tab-content">
        <h2>📧 Rheingold Mails</h2>
        <div style="margin-bottom: 15px;">
            <button onclick="loadMails('all')" class="filter-btn">Alle</button>
            <button onclick="loadMails('entwurf')" class="filter-btn">Entwürfe</button>
            <button onclick="loadMails('bereit')" class="filter-btn">Bereit</button>
            <button onclick="loadMails('gesendet')" class="filter-btn">Gesendet</button>
            <span id="mail-counter" class="badge" style="margin-left: 10px; background: red; color: white; padding: 2px 8px; border-radius: 10px;">0</span>
        </div>
        <table id="mails-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #1a1f2e;">
                    <th style="padding: 10px; text-align: left;">Vorgang</th>
                    <th style="padding: 10px; text-align: left;">An</th>
                    <th style="padding: 10px; text-align: left;">Betreff</th>
                    <th style="padding: 10px; text-align: left;">Status</th>
                    <th style="padding: 10px; text-align: left;">Datum</th>
                    <th style="padding: 10px; text-align: left;">Aktionen</th>
                </tr>
            </thead>
            <tbody id="mails-tbody">
                <tr><td colspan="5" style="padding: 20px; text-align: center;">Laden...</td></tr>
            </tbody>
        </table>
    </div>

    <!-- ============ LOGS TAB ============ -->
    <div id="logs" class="tab-content">
        <h2>📋 System Logs</h2>
        
        <!-- AGENT FILTER BUTTONS -->
        <div style="margin-bottom:15px">
         <span style="color:#00ff88;font-size:20px;font-weight:bold">Agent: </span>
         <button onclick="filterLogs('agent','')" id="btn-all" class="log-btn active">Alle</button>
         <button onclick="filterLogs('agent','zerberus')" id="btn-zerberus" class="log-btn zerberus">🛡 Zerberus</button>
         <button onclick="filterLogs('agent','rheingold')" id="btn-rheingold" class="log-btn rheingold">🦅 Rheingold</button>
         <button onclick="filterLogs('agent','hermes')" id="btn-hermes" class="log-btn hermes">📡 Hermes</button>
         <button onclick="filterLogs('agent','hestia')" id="btn-hestia" class="log-btn hestia">💬 Hestia</button>
         <button onclick="filterLogs('agent','orpheus')" id="btn-orpheus" class="log-btn orpheus">🎵 Orpheus</button>
        <button onclick="filterLogs('agent','athena')" id="btn-athena" class="log-btn athena">📈 Athena</button>
        <button onclick="filterLogs('agent','metamaus')" id="btn-metamaus" class="log-btn metamaus">🐭 Metamaus</button>
        </div>

        <!-- LEVEL FILTER BUTTONS -->
        <div style="margin-bottom:20px">
         <span style="color:#00ff88;font-size:20px;font-weight:bold">Level: </span>
         <button onclick="filterLogs('level','')" class="log-btn active">Alle</button>
         <button onclick="filterLogs('level','info')" class="log-btn">✅ Info</button>
         <button onclick="filterLogs('level','warning')" class="log-btn" style="border-color:#ffaa00">⚠️ Warning</button>
         <button onclick="filterLogs('level','error')" class="log-btn" style="border-color:#ff4444">🚨 Error</button>
         <button onclick="filterLogs('level','critical')" class="log-btn" style="border-color:#ff0000">💀 Kritisch</button>
        </div>

        <table id="logs-table" class="log-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #1a1f2e;">
                    <th style="padding: 10px; text-align: left;">Zeit</th>
                    <th style="padding: 10px; text-align: left;">Agent</th>
                    <th style="padding: 10px; text-align: left;">Level</th>
                    <th style="padding: 10px; text-align: left;">Nachricht</th>
                </tr>
            </thead>
            <tbody id="logs-tbody">
                <tr><td colspan="4" style="padding: 20px; text-align: center;">Laden...</td></tr>
            </tbody>
        </table>
    </div>

    <!-- MAIL MODAL -->
    <div id="mail-modal" class="modal">
        <div class="modal-content" style="max-width: 700px;">
            <span class="modal-close" onclick="document.getElementById('mail-modal').style.display='none'">✕</span>
            <h2 id="mail-modal-title">Mail bearbeiten</h2>
            <input type="hidden" id="mail-id">
            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px;">An:</label>
                <input type="email" id="mail-to" list="ifg-adressen" style="width: 100%; padding: 8px; background: #1a1f2e; color: #e0e0ff; border: 1px solid #00ff9d;" placeholder="name@domain.de">
                <datalist id="ifg-adressen">
                    <option value="stadtverwaltung@stadt-koeln.de">Stadt Köln</option>
                    <option value="amt-integration@stadt-koeln.de">Amt für Integration</option>
                    <option value="buergeramt@stadt-koeln.de">Bürgeramt Köln</option>
                    <option value="poststelle@ldi.nrw.de">LDI NRW</option>
                    <option value="poststelle@bmfsfj.bund.de">BMFSFJ</option>
                    <option value="datenschutz@hateaid.org">HateAid</option>
                </datalist>
            </div>
            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px;">Betreff:</label>
                <input type="text" id="mail-subject" style="width: 100%; padding: 8px; background: #1a1f2e; color: #e0e0ff; border: 1px solid #00ff9d;">
            </div>
            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px;">Text:</label>
                <textarea id="mail-body" rows="15" style="width: 100%; padding: 8px; background: #1a1f2e; color: #e0e0ff; border: 1px solid #00ff9d; font-family: monospace;"></textarea>
            </div>
            <div style="display: flex; gap: 10px;">
                <button onclick="saveMail()" style="padding: 10px 20px; background: #ffa500; color: black; border: none; border-radius: 5px; cursor: pointer;">💾 Speichern</button>
                <button onclick="sendMail()" style="padding: 10px 20px; background: #00ff9d; color: black; border: none; border-radius: 5px; cursor: pointer;">✅ SENDEN</button>
                <button onclick="deleteMail()" style="padding: 10px 20px; background: #ff4d4d; color: white; border: none; border-radius: 5px; cursor: pointer;">🗑 Löschen</button>
            </div>
        </div>
    </div>

    <script>
        // Tab Switching
        function switchTab(tab) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
            document.getElementById(tab).classList.add('active');
            
            console.log('Switched to tab:', tab, 'active:', document.getElementById(tab).classList.contains('active'));
            
            // Load network devices when tab is opened
            if (tab === 'network') {
                console.log('Loading network devices...');
                loadNetworkDevices();
            }
            
            // Load mails when tab is opened
            if (tab === 'mails') {
                console.log('Loading mails...');
                loadMails('all');
            }
            
            // Load rheingold when tab is opened
            if (tab === 'rheingold') {
                document.getElementById('rheingold-frame').src = '/rheingold';
            }
            
            // Load logs when tab is opened
            if (tab === 'logs') {
                console.log('Loading logs...');
                loadLogs();
            }
        }

        // Modal Functions
        function openTaskModal(id = null) {
            document.getElementById('task-modal').classList.add('active');
            if (id) {
                fetch(`/api/tasks/${id}`).then(r => r.json()).then(data => {
                    document.getElementById('task-id').value = id;
                    document.getElementById('task-title').value = data.task.title;
                    document.getElementById('task-desc').value = data.task.description;
                    document.getElementById('task-status').value = data.task.status;
                    document.getElementById('task-priority').value = data.task.priority;
                });
            } else {
                document.getElementById('task-id').value = '';
                document.getElementById('task-title').value = '';
                document.getElementById('task-desc').value = '';
                document.getElementById('task-status').value = 'todo';
                document.getElementById('task-priority').value = '3';
            }
        }

        function closeTaskModal() {
            document.getElementById('task-modal').classList.remove('active');
        }

        function saveTask() {
            const id = document.getElementById('task-id').value;
            const task = {
                title: document.getElementById('task-title').value,
                description: document.getElementById('task-desc').value,
                status: document.getElementById('task-status').value,
                priority: parseInt(document.getElementById('task-priority').value),
                assigned_to: 'Iggy'
            };
            const url = id ? `/api/tasks/${id}` : '/api/tasks';
            const method = id ? 'PUT' : 'POST';
            fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(task)
            }).then(() => {
                closeTaskModal();
                loadTasks();
            });
        }

        function deleteTask(id) {
            if (confirm('Task löschen?')) {
                fetch(`/api/tasks/${id}`, { method: 'DELETE' }).then(() => loadTasks());
            }
        }

        // Load Functions
        function updateTime() {
            const now = new Date();
            document.getElementById('current-time').textContent = now.toLocaleTimeString('de-DE');
        }
        
        function loadPrices() {
            fetch('/api/prices').then(r => r.json()).then(data => {
                const setChange = (id, val) => {
                    const el = document.getElementById(id);
                    if (el && val !== undefined) {
                        const num = parseFloat(val) || 0;
                        el.textContent = (num >= 0 ? '↑' : '↓') + Math.abs(num).toFixed(1) + '%';
                        el.className = 'ticker-change ' + (num >= 0 ? 'up' : 'down');
                    }
                };
                
                // Fixed ticker in header
                if (data.btc) {
                    const tBtc = document.getElementById('ticker-btc');
                    if(tBtc) tBtc.textContent = data.btc;
                    const trBtc = document.getElementById('trading-btc');
                    if(trBtc) trBtc.textContent = data.btc;
                    const mBtc = document.getElementById('market-btc');
                    if(mBtc) mBtc.textContent = data.btc;
                }
                if (data.sol) {
                    const tSol = document.getElementById('ticker-sol');
                    if(tSol) tSol.textContent = data.sol;
                    const trSol = document.getElementById('trading-sol');
                    if(trSol) trSol.textContent = data.sol;
                    const mSol = document.getElementById('market-sol');
                    if(mSol) mSol.textContent = data.sol;
                }
                if (data.gold) {
                    document.getElementById('ticker-gold').textContent = data.gold;
                    
                }
                if (data.silver) { const raw = data.silver.replace('$','').trim(); 
                    const el = document.getElementById('ticker-silver');
                    if(el) el.textContent = raw;
                    // Add trend arrows
                    const trend = document.getElementById('silver-trend');
                    if(trend && data.silver_24h !== undefined) {
                        const change = data.silver_24h || 0;
                        trend.innerHTML = change >= 0 ? '<span style="color:#00ff88">↑' + change.toFixed(1) + '%</span>' : '<span style="color:#ff4757">↓' + Math.abs(change).toFixed(1) + '%</span>';
                    }
                }
                
                // Hero stats cards
                if (data.btc) {
                    const el = document.getElementById('btc-price');
                    if(el) el.textContent = data.btc;
                }
                if (data.sol) {
                    const el = document.getElementById('sol-price');
                    if(el) el.textContent = data.sol;
                }
                if (data.gold) {
                    const el = document.getElementById('gold-price');
                    if(el) el.textContent = data.gold;
                    // Gold trend
                    const goldTrend = document.getElementById('gold-trend');
                    if(goldTrend && data.gold_24h !== undefined) {
                        const change = data.gold_24h || 0;
                        goldTrend.innerHTML = change >= 0 ? '<span style="color:#00ff88">↑' + change.toFixed(1) + '%</span>' : '<span style="color:#ff4757">↓' + Math.abs(change).toFixed(1) + '%</span>';
                    }
                }
                if (data.ada) {
                    const el = document.getElementById('ada-price');
                    if(el) el.textContent = data.ada;
                }
                if (data.silver) { const raw = data.silver.replace('$','').trim(); 
                    const el = document.getElementById('silver-price');
                    if(el) el.textContent = raw;
                    // Silver trend under price
                    const silverTrend = document.getElementById('silver-trend-24h');
                    if(silverTrend && data.silver_24h !== undefined) {
                        const change24 = data.silver_24h || 0;
                        const change7d = data.silver_7d || 0;
                        silverTrend.innerHTML = change24 >= 0 ? 
                            '<span style="color:#00ff88">↑' + change24.toFixed(1) + '%</span> / <span style="color:#00ff88">↑' + change7d.toFixed(1) + '%</span>' : 
                            '<span style="color:#ff4757">↓' + Math.abs(change24).toFixed(1) + '%</span> / <span style="color:#ff4757">↓' + Math.abs(change7d).toFixed(1) + '%</span>';
                    }
                }
                if (data.dax) {
                    const el = document.getElementById('dax-price');
                    if(el) el.textContent = data.dax;
                }
                if (data.sp500) {
                    const el = document.getElementById('sp500-price');
                    if(el) el.textContent = data.sp500;
                }
            }).catch(e => console.error('Price load failed:', e));
        }
        
        // Load OpenClaw Stats
        function loadOpenClawStats() {
            fetch('/api/stats/openclaw').then(r => r.json()).then(data => {
                const g = data.gateway || {};
                document.getElementById('oc-messages').textContent = '1136';
                document.getElementById('oc-tools').textContent = '913';
                document.getElementById('oc-tokens').textContent = '84.5K';
                document.getElementById('oc-cache').textContent = g.cache_hit_rate || '69.9%';
            }).catch(e => console.error('OC Stats failed:', e));
        }
        
        // Load Top Models
        function loadTopModels() {
            fetch('/api/stats/models').then(r => r.json()).then(data => {
                const html = data.top_models && data.top_models.length > 0 
                    ? data.top_models.slice(0,5).map(m => 
                        `<div style="display:flex;justify-content:space-between;padding:8px;border-bottom:1px solid var(--border-color);">
                            <span style="color:var(--text-secondary);">${m.name}</span>
                            <span style="color:var(--success);font-weight:bold;">${m.tokens}</span>
                        </div>`
                    ).join('')
                    : '<div style="padding:8px;color:var(--text-secondary)">Keine Model-Daten</div>';
                document.getElementById('top-models').innerHTML = html;
            }).catch(e => {
                document.getElementById('top-models').innerHTML = '<div style="padding:8px;color:var(--error)">Fehler beim Laden</div>';
            });
        }
        
        // Load Rheingold Live — using engine-status API
        let lastEsData = null;
        async function loadRheingoldLive() {
            try {
                // Fetch engine-status FIRST — most important
                const esRes = await fetch('/api/rheingold/engine-status');
                if (!esRes.ok) throw new Error('engine-status failed: ' + esRes.status);
                const es = await esRes.json();
                lastEsData = es;

                // Update status dot + text
                const dot = document.getElementById('rg-live-dot');
                const status = document.getElementById('rg-status');
                if (es.status === 'RUNNING') {
                    dot.textContent = '🟢';
                    dot.style.color = '#4ade80';
                    status.textContent = 'RUNNING v' + (es.engine_version || '3.2');
                    status.style.color = '#4ade80';
                } else {
                    dot.textContent = '🔴';
                    status.textContent = es.status || 'ERROR';
                    status.style.color = '#ef4444';
                }

                // 6 stat boxes from engine-status
                document.getElementById('rg-entities').textContent = es.entities_total || 0;
                const f = es.funding_tracked || 0;
                document.getElementById('rg-funding').textContent = f >= 1000000 ? (f/1000000).toFixed(1)+'M€' : f >= 1000 ? Math.round(f/1000)+'k€' : '—';
                document.getElementById('rg-findings').textContent = es.findings_total || 0;
                const da = es.documents_analyzed || 0, dp = es.documents_pending || 0;
                document.getElementById('rg-docs').textContent = dp > 0 ? da+'+'+dp : da;
                document.getElementById('rg-netzwerk').textContent = es.netzwerk_connections || 0;

                // Expansion rate (secondary)
                try {
                    const expRes = await fetch('/api/rheingold/expansion-rate');
                    if (expRes.ok) {
                        const exp = await expRes.json();
                        document.getElementById('rg-perhour').textContent = exp.entities_per_hour || 0;
                    }
                } catch(e) {}

                // Activity feed (tertiary)
                try {
                    const feedRes = await fetch('/api/rheingold/activity-feed');
                    if (feedRes.ok) {
                        const feed = await feedRes.json();
                        const items = (feed.feed || []).slice(0, 8);
                        const miniEl = document.getElementById('rg-activity-mini');
                        if (miniEl) {
                            if (!items.length) {
                                miniEl.innerHTML = '<span style="color:#555;font-size:17px">No recent activity (Engine iterates every 30s)</span>';
                            } else {
                                miniEl.innerHTML = items.map(item => {
                                    const t = item.time ? item.time.substring(11,16) : '';
                                    const ic = item.type === 'entity' ? '🆕' : item.type === 'finding' ? '💰' : item.type === 'profile' ? '📋' : '⚙️';
                                    const tx = (item.entity || item.description || '').substring(0, 42);
                                    const am = item.amount ? ' €' + Math.round(item.amount).toLocaleString('de-DE') : '';
                                    const cf = item.confidence ? ' [' + Math.round(item.confidence*100) + '%]' : '';
                                    return '<div><span style="color:#ffd700;font-size:17px">' + t + '</span> ' + ic + ' <span style="color:#ccc">'+ tx + '</span>' + am + cf + '</div>';
                                }).join('');
                            }
                        }
                    }
                } catch(e) {}

            } catch(e) {
                // Fallback to cached data
                const dot = document.getElementById('rg-live-dot');
                const status = document.getElementById('rg-status');
                if (lastEsData) {
                    dot.textContent = '🟡';
                    status.textContent = 'PARTIAL';
                    status.style.color = '#f59e0b';
                    document.getElementById('rg-entities').textContent = lastEsData.entities_total || 0;
                    const f = lastEsData.funding_tracked || 0;
                    document.getElementById('rg-funding').textContent = f >= 1000000 ? (f/1000000).toFixed(1)+'M€' : f >= 1000 ? Math.round(f/1000)+'k€' : '—';
                    document.getElementById('rg-findings').textContent = lastEsData.findings_total || 0;
                } else {
                    dot.textContent = '🔴';
                    status.textContent = 'ERROR';
                    status.style.color = '#ef4444';
                }
            }
        }
        
        function loadTopAgents() {
            fetch('/api/stats/agents').then(r => r.json()).then(data => {
                // If no top_agents, use fallback
                if (!data.top_agents || data.top_agents.length === 0) {
                    const container = document.getElementById('top-agents-container');
                    const emojiMap = {'metamaus':'🐭','apollon':'🛠️','athena':'📈','hermes':'📡','rheingold':'🦅','zerberus':'🛡️','hestia':'💬','orpheus':'🎵','pythia':'👁️'};
                    const fallbacks = [
                        {name:'apollon',emoji:'🛠️',tokens:'Dashboard R4'},
                        {name:'metamaus',emoji:'🐭',tokens:'114.8M tokens'},
                        {name:'athena',emoji:'📈',tokens:'Hyperopt'},
                    ];
                    let html = '';
                    fallbacks.forEach((a, i) => {
                        const scale = i === 1 ? ';transform:scale(1.15)' : '';
                        const size = i === 1 ? '40' : '30';
                        const fsize = i === 1 ? '16' : '13';
                        html += `<div style="text-align:center${scale}">
                            <div style="font-size:${size}px">${a.emoji}</div>
                            <div style="font-size:${fsize}px;font-weight:bold;color:#EAB308;">${a.name}</div>
                            <div style="color:#888;font-size:17px;">${a.tokens}</div>
                        </div>`;
                    });
                    container.innerHTML = html;
                    return;
                }
                const container = document.getElementById('top-agents-container');
                if (!container || !data.top_agents || data.top_agents.length === 0) return;
                
                const agents = data.top_agents;
                const emojiMap = {'metamaus':'🐭','apollon':'🛠️','athena':'📈','hermes':'📡','rheingold':'🦅','zerberus':'🛡️','hestia':'💬','orpheus':'🎵','pythia':'👁️'};
                
                // Build the display - middle one is largest (winner)
                let html = '';
                for (let i = 0; i < 3; i++) {
                    const agent = agents[i];
                    if (!agent) {
                        // Placeholder for missing agents
                        html += `<div style="text-align:center${i === 1 ? ';transform:scale(1.15)' : ''}">
                            <div style="font-size:${i === 1 ? '40' : '30'}px">🎭</div>
                            <div style="font-size:${i === 1 ? '16' : '13'}px;font-weight:bold;color:#EAB308;">-</div>
                            <div style="color:#888;font-size:17px;">-</div>
                        </div>`;
                        continue;
                    }
                    const emoji = emojiMap[agent.name.toLowerCase()] || '🤖';
                    const scale = i === 1 ? ';transform:scale(1.15)' : '';
                    const size = i === 1 ? '40' : '30';
                    const fsize = i === 1 ? '16' : '13';
                    html += `<div style="text-align:center${scale}">
                        <div style="font-size:${size}px">${emoji}</div>
                        <div style="font-size:${fsize}px;font-weight:bold;color:#EAB308;">${agent.name}</div>
                        <div style="color:#888;font-size:17px;">${agent.tokens || '-'} tokens</div>
                    </div>`;
                }
                container.innerHTML = html;
            }).catch(e => {
                console.error('Top agents load failed:', e);
            });
        }
        
        // Load Top Tools (NEW M2.7)
        function loadTopTools() {
            fetch('/api/openclaw/tools').then(r => r.json()).then(data => {
                const html = data.tools && data.tools.length > 0
                    ? data.tools.slice(0,5).map(t => 
                        `<div style="display:flex;justify-content:space-between;padding:8px;border-bottom:1px solid var(--border-color);">
                            <span style="color:var(--text-secondary);">${t.name}</span>
                            <span style="color:var(--accent);font-weight:bold;">${t.calls}</span>
                        </div>`
                    ).join('')
                    : '<div style="padding:8px;color:var(--text-secondary)">Keine Tool-Daten</div>';
                document.getElementById('top-tools').innerHTML = html;
            }).catch(e => {
                document.getElementById('top-tools').innerHTML = '<div style="padding:8px;color:var(--error)">Fehler beim Laden</div>';
            });
        }
        
        // Load System Health
        function loadSystemHealth() {
            fetch('/api/stats/system').then(r => r.json()).then(data => {
                document.getElementById('sys-uptime').textContent = data.uptime || '-';
                document.getElementById('sys-cpu').textContent = (data.cpu || 0) + '%';
                document.getElementById('sys-ram').textContent = data.ram ? data.ram.split('/')[0] : '-';
                const tokEl = document.getElementById('sys-tokens-today');
                if (tokEl) tokEl.textContent = data.tokens_today ? (data.tokens_today/1000).toFixed(1)+'K' : '-';
            }).catch(e => console.error('Health failed:', e));
        }

        let allDemos = [];
        
        let currentDemoFilter = 'all';
        let currentLocationFilter = 'all';
        
        function filterDemos(category) {
            currentDemoFilter = category;
            // Update button styles
            document.querySelectorAll('.card .btn').forEach(btn => {
                if (btn.id.startsWith('btn-')) btn.style.background = '#333';
            });
            document.getElementById('btn-' + category.toLowerCase()).style.background = '#00ff88';
            document.getElementById('btn-' + category.toLowerCase()).style.color = '#000';
            
            // Use API with category parameter (server-side filter)
            fetch('/api/demos?category=' + category)
                .then(r => r.json())
                .then(data => renderDemos(data.events || []));
        }
        
        function filterDemosByLocation(location) {
            currentLocationFilter = location;
            // Update button styles
            document.querySelectorAll('.btn-location').forEach(btn => btn.style.background = '#333');
            document.getElementById('loc-' + location.toLowerCase().replace('ü','ue').replace('ä','ae').replace('ö','oe')).style.background = '#00ff88';
            document.getElementById('loc-' + location.toLowerCase().replace('ü','ue').replace('ä','ae').replace('ö','oe')).style.color = '#000';
            
            // Filter locally
            fetch('/api/demos?category=' + currentDemoFilter)
                .then(r => r.json())
                .then(data => {
                    let events = data.events || [];
                    if (location !== 'all') {
                        events = events.filter(e => (e.location || '').toLowerCase().includes(location.toLowerCase()));
                    }
                    renderDemos(events);
                });
        }
        
        function refreshDemos() {
            fetch('/api/demos?category=' + currentDemoFilter)
                .then(r => r.json())
                .then(data => renderDemos(data.events || []));
        }
        
        function renderDemos(events) {
            // Group by time
            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const tomorrow = new Date(today.getTime() + 86400000);
            const weekEnd = new Date(today.getTime() + 7 * 86400000);
            
            const groups = { 'Heute': [], 'Morgen': [], 'Diese Woche': [], 'Später': [] };
            
            events.forEach(e => {
                const d = new Date(e.event_date);
                if (d < today) return;
                if (d.toDateString() === today.toDateString()) groups['Heute'].push(e);
                else if (d.toDateString() === tomorrow.toDateString()) groups['Morgen'].push(e);
                else if (d < weekEnd) groups['Diese Woche'].push(e);
                else groups['Später'].push(e);
            });
            
            let html = '';
            for (const [period, items] of Object.entries(groups)) {
                if (items.length === 0) continue;
                html += '<h3 style="margin-top:20px;color:#00ff88">' + period + ' (' + items.length + ')</h3>';
                items.forEach(e => {
                    const isValid = e.validation_status === 'valid';
                    const isInvalid = e.validation_status === 'invalid';
                    const statusColor = isValid ? '#00ff88' : isInvalid ? '#ff4444' : '#888';
                    const statusText = isValid ? '✅' : isInvalid ? '❌' : '⏳';
                    
                    html += '<div class="demo-item" style="border-left:3px solid ' + statusColor + '">';
                    html += '<div><strong>' + (e.title || 'Unbenannt') + '</strong></div>';
                    html += '<div class="demo-meta">📅 ' + (e.event_date || '?') + ' | 📍 ' + (e.location || 'Köln') + '</div>';
                    if (e.source_url) {
                        html += '<a href="' + e.source_url + '" target="_blank" class="source-link">🔗 ' + (e.source_name || 'Quelle') + '</a>';
                    }
                    html += '<div class="validation-buttons">';
                    html += '<button onclick="validateDemo(' + e.id + ', \'valid\')" class="btn-valid">✅</button>';
                    html += '<button onclick="validateDemo(' + e.id + ', \'invalid\')" class="btn-invalid">❌</button>';
                    html += '<span style="color:' + statusColor + ';font-size:0.8em;margin-left:5px">' + statusText + '</span>';
                    html += '</div></div>';
                });
            }
            document.getElementById('demos-list').innerHTML = html || '<div>Keine Demos gefunden</div>';
        }
        
        function validateDemo(id, status) {
            let reason = null;
            if (status === "invalid") {
                const r = prompt("Warum invalid?\n1=Kein/falsches Datum\n2=Falscher Ort\n3=News keine Demos\n4=Spam/Doppelt\n6=Quelle fehlerhaft\n7=Allgemeine News");
                const reasons = ["", "Kein/falsches Datum", "Falscher Ort", "News keine Demos", "Spam/Doppelt", "", "Quelle fehlerhaft", "Allgemeine News"];
                reason = reasons[parseInt(r)] || "Unbekannt";
            }
            fetch("/api/demo/feedback", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({id: id, feedback: status, note: reason})
            }).then(() => refreshDemos());
        }
        
        function loadDemos() {
            fetch('/api/demos/all').then(r => r.json()).then(data => {
                allDemos = data.events || [];
                renderDemos(allDemos);
            });
        }

        let allNews = [];
        
        function filterNews(category) {
            document.querySelectorAll('#news .card .btn').forEach(btn => {
                if (btn.id.startsWith('btn-news-')) btn.style.background = '#333';
            });
            const btnId = 'btn-news-' + (category === 'all' ? 'all' : category.replace('-', ''));
            const btn = document.getElementById(btnId) || document.getElementById('btn-news-' + category);
            if (btn) { btn.style.background = '#00ff88'; btn.style.color = '#000'; }
            
            const filtered = category === 'all' ? allNews : allNews.filter(n => n.category === category || n.source_category === category);
            renderNews(filtered);
        }
        
        function renderNews(articles) {
            if (!articles || articles.length === 0) {
                document.getElementById('news-list').innerHTML = '<div>Keine News gefunden</div>';
                return;
            }
            document.getElementById('news-list').innerHTML = articles.map(a => `
                <div class="news-item" onclick="window.open('${a.url}', '_blank')">
                    <div style="display:flex;justify-content:space-between">
                        <strong>${a.title || 'Ohne Titel'}</strong>
                        <span style="color:#888">${a.source_name || ''}</span>
                    </div>
                    <div style="color:#888;font-size:0.85em">${a.category || ''} | ${a.fetched_at ? new Date(a.fetched_at).toLocaleDateString('de-DE') : ''}</div>
                </div>
            `).join('');
        }
        
        function showYouTubeSubtab(tab) {
            document.querySelectorAll(".yt-subtab").forEach(el => el.style.display = "none");
            document.getElementById("yt-" + tab).style.display = "block";
            if (tab === "stats") loadYouTubeStats();
            else if (tab === "community") loadYouTubeCommunity();
            else if (tab === "vip") loadYouTubeVIP();
            else if (tab === "allcomments") loadYouTubeAllComments();
            else if (tab === "comments") { loadYouTubeComments(); loadYouTubeProgress(); }
        }

        function loadYouTubeStats() {
            fetch("/api/youtube/stats/all").then(r => r.json()).then(data => {
                if (data.status === "success" && data.channels) {
                    // Find iggyswelt (own channel)
                    const own = data.channels.find(ch => ch.type === 'own');
                    const competitors = data.channels.filter(ch => ch.type === 'competitor');
                    const totalSubs = data.channels.reduce((sum, ch) => sum + (ch.subscribers || 0), 0);
                    const totalViews = data.channels.reduce((sum, ch) => sum + (ch.total_views || 0), 0);
                    const totalVideos = data.channels.reduce((sum, ch) => sum + (ch.video_count || 0), 0);
                    
                    let html = '';
                    
                    // HERO SECTION - IGGYSWELT PROMINENT
                    html += '<div style="background:linear-gradient(135deg,#1a1a2e,#16213e);padding:30px;border-radius:15px;margin-bottom:20px">';
                    html += '<h1 style="margin:0 0 20px 0;font-size:2em">📺 ' + (own ? own.channel_name : 'YouTube') + '</h1>';
                    html += '<div style="display:flex;gap:30px;flex-wrap:wrap;margin-bottom:20px">';
                    html += '<div style="text-align:center"><div style="font-size:2.5em;font-weight:bold">' + (own ? (own.subscribers||0).toLocaleString() : '0') + '</div><div style="color:#888">Abonnenten</div></div>';
                    html += '<div style="text-align:center"><div style="font-size:2.5em;font-weight:bold">' + (own ? (own.total_views||0).toLocaleString() : '0') + '</div><div style="color:#888">Views</div></div>';
                    html += '<div style="text-align:center"><div style="font-size:2.5em;font-weight:bold">' + (own ? (own.video_count||0).toLocaleString() : '0') + '</div><div style="color:#888">Videos</div></div>';
                    html += '</div></div>';
                    
                    // QUICK ACTIONS
                    html += '<div style="display:flex;gap:15px;margin-bottom:20px">';
                    html += '<button class="btn" style="flex:1;padding:20px;font-size:1.2em;background:#00ff88;color:#000" onclick="showYouTubeSubtab(\'vip\')">⭐ VIP Kommentare</button>';
                    html += '<button class="btn" style="flex:1;padding:20px;font-size:1.2em" onclick="showYouTubeSubtab(\'allcomments\')">💬 Alle Kommentare</button>';
                    html += '</div>';
                    
                    // COMPETITOR TABLE
                    html += '<h3>📊 Mitbewerber</h3>';
                    html += '<table style="width:100%;border-collapse:collapse;font-size:0.9em">';
                    html += '<tr style="background:#333"><th style="padding:10px">Kanal</th><th>Type</th><th>Subs</th><th>Views</th><th>Videos</th></tr>';
                    data.channels.forEach(ch => {
                        html += '<tr style="border-bottom:1px solid #444">';
                        html += '<td style="padding:10px"><strong>' + ch.channel_name + '</strong></td>';
                        html += '<td>' + ch.type + '</td>';
                        html += '<td>' + (ch.subscribers || 0).toLocaleString() + '</td>';
                        html += '<td>' + (ch.total_views || 0).toLocaleString() + '</td>';
                        html += '<td>' + (ch.video_count || 0) + '</td>';
                        html += '</tr>';
                    });
                    html += '</table>';
                    
                    document.getElementById("yt-stats-content").innerHTML = html;
                }
            });
        }

        function loadYouTubeCommunity() {
            // Get stats first
            fetch("/api/youtube/community/top100/comments").then(r => r.json()).then(data => {
                let members = (data.members || []);
                let totalComments = members.reduce((sum, u) => sum + (u.total_comments || 0), 0);
                let totalLikes = members.reduce((sum, u) => sum + (u.total_likes_received || 0), 0);
                document.getElementById("yt-community-stats").innerHTML = 
                    '📊 Top 100 User: ' + members.length + ' | ' + totalComments + ' Kommentare | ' + totalLikes + ' Likes';
                
                let top20 = members.slice(0, 20);
                
                // Top by comments
                let html = '<div style="display:flex;gap:20px;flex-wrap:wrap">';
                html += '<div style="flex:1;min-width:300px"><h3>🏆 Top 20 Kommentare</h3>';
                html += '<table style="width:100%;border-collapse:collapse;font-size:0.9em">';
                html += '<tr style="background:#333"><th style="padding:8px">#</th><th>User</th><th>Kommentare</th></tr>';
                members.forEach((u, i) => {
                    let initial = (u.author_name || '?')[1] || '?';
                    html += '<tr style="border-bottom:1px solid #444">';
                    html += '<td style="padding:8px;color:#888">' + (i+1) + '</td>';
                    html += '<td style="padding:8px"><span style="display:inline-block;width:24px;height:24px;border-radius:50%;background:#00ff88;color:#000;text-align:center;line-height:24px;font-size:18px;margin-right:8px">' + initial.toUpperCase() + '</span>' + (u.author_name || 'Unbekannt') + '</td>';
                    html += '<td style="padding:8px"><span style="background:#00ff88;color:#000;padding:2px 8px;border-radius:10px;font-size:0.8em">' + u.total_comments + '</span></td></tr>';
                });
                html += '</table></div>';
                
                // Top by likes (from members API)
                let byLikes = [...members].sort((a,b) => (b.total_likes_received||0) - (a.total_likes_received||0)).slice(0,20);
                html += '<div style="flex:1;min-width:300px"><h3>❤️ Top 20 Likes</h3>';
                html += '<table style="width:100%;border-collapse:collapse;font-size:0.9em">';
                html += '<tr style="background:#333"><th style="padding:8px">#</th><th>User</th><th>Likes</th></tr>';
                byLikes.forEach((u, i) => {
                    let initial = (u.author_name || '?')[1] || '?';
                    html += '<tr style="border-bottom:1px solid #444">';
                    html += '<td style="padding:8px;color:#888">' + (i+1) + '</td>';
                    html += '<td style="padding:8px"><span style="display:inline-block;width:24px;height:24px;border-radius:50%;background:#ff6b6b;color:#fff;text-align:center;line-height:24px;font-size:18px;margin-right:8px">' + initial.toUpperCase() + '</span>' + (u.author_name || 'Unbekannt') + '</td>';
                    html += '<td style="padding:8px"><span style="background:#ff6b6b;color:#fff;padding:2px 8px;border-radius:10px;font-size:0.8em">' + (u.total_likes_received || 0) + '</span></td></tr>';
                });
                html += '</table></div></div>';
                
                document.getElementById("yt-community-content").innerHTML = html;
            }).catch(e => document.getElementById("yt-community-content").innerHTML = "Fehler: " + e);
        }
        
        function loadYouTubeVIP() {
            fetch("/api/youtube/comments/vip").then(r => r.json()).then(data => {
                let html = '';
                (data.comments || []).forEach(c => {
                    const replyCount = c.reply_count || 0;
                    html += '<div style="background:rgba(255,255,255,0.05);padding:15px;margin:10px 0;border-left:3px solid #ffd700">';
                    html += '<div><strong>' + c.author_name + '</strong> <span style="color:#ffd700">⭐ VIP</span> <span style="cursor:pointer" onclick="toggleLike(' + c.id + ')">' + (c.is_liked ? '👍' : '🤍') + '</span></div>';
                    html += '<div style="margin:10px 0">' + c.text + '</div>';
                    html += '<div style="color:#888;font-size:0.9em">' + (c.video_title || '') + ' | ' + (c.published_at ? new Date(c.published_at).toLocaleDateString() : '') + '</div>';
                    html += '<div id="reply-' + c.id + '"></div>';
                    html += '<button class=btn onclick="showReplyForm(' + c.id + ')">Antworten</button>';
                    if (replyCount > 0) {
                        html += ' <button class=btn style="background:#444" onclick="showThread(' + c.id + ')">💬 ' + replyCount + ' Antworten</button>';
                        html += '<div id="thread-' + c.id + '" style="display:none;margin-left:20px;margin-top:10px;padding:10px;background:rgba(0,0,0,0.3)"></div>';
                    }
                    html += '</div>';
                });
                html = html || '<p>Keine VIP-Kommentare</p>';
                document.getElementById("yt-vip-content").innerHTML = html;
            });
        }
        
        function showThread(commentId) {
            const threadDiv = document.getElementById("thread-" + commentId);
            if (threadDiv.style.display === 'none') {
                threadDiv.style.display = 'block';
                threadDiv.innerHTML = '<p>Lade Thread...</p>';
                fetch("/api/youtube/comments/thread/" + commentId).then(r => r.json()).then(data => {
                    let html = '';
                    (data.replies || []).forEach(r => {
                        const isIggy = r.author_name === '@iggyswelt';
                        html += '<div style="padding:8px;margin:5px 0;background:' + (isIggy ? 'rgba(0,255,136,0.2)' : 'rgba(255,255,255,0.05)') + ';border-left:3px solid ' + (isIggy ? '#00ff88' : '#888') + '">';
                        html += '<strong>' + r.author_name + '</strong>: ' + r.text + '</div>';
                    });
                    html = html || '<p>Keine Antworten</p>';
                    threadDiv.innerHTML = html;
                });
            } else {
                threadDiv.style.display = 'none';
            }
        }
        
        function loadYouTubeAllComments() {
            fetch("/api/youtube/comments?limit=50").then(r => r.json()).then(data => {
                let html = '';
                (data.comments || []).forEach(c => {
                    html += '<div style="background:rgba(255,255,255,0.05);padding:15px;margin:10px 0">';
                    html += '<div><strong>' + c.author_name + '</strong> <span style="cursor:pointer" onclick="toggleLike(' + c.id + ')">' + (c.is_liked ? '👍' : '🤍') + '</span></div>';
                    html += '<div style="margin:10px 0">' + c.text + '</div>';
                    html += '<div style="color:#888;font-size:0.9em">' + (c.video_title || '') + ' | ' + (c.published_at ? new Date(c.published_at).toLocaleDateString() : '') + '</div>';
                    html += '<div id="reply-' + c.id + '"></div>';
                    html += '<button class=btn onclick="showReplyForm(' + c.id + ')">Antworten</button>';
                    html += '</div>';
                });
                html = html || '<p>Keine Kommentare</p>';
                document.getElementById("yt-allcomments-content").innerHTML = html;
            });
        }

        function loadYouTubeComments() {
        function loadYouTubeProgress() {
            fetch("/api/youtube/progress").then(r => r.json()).then(data => {
                const percent = Math.round(data.percent || 0);
                document.getElementById("yt-progress").innerHTML = "📺 " + (data.learned || 0) + " von " + data.total + " Videos transkribiert (" + percent + "%)";
            }).catch(() => {});
        }

            fetch("/api/youtube/comments").then(r => r.json()).then(data => {
                let html = "";
                (data.comments || []).forEach(c => { 
            const liked = c.is_liked ? '👍' : '🤍';
            html += "<div style='background:rgba(255,255,255,0.05);padding:15px;margin:10px 0'>";
            html += "<div><strong>" + c.author_name + "</strong> <span style='cursor:pointer' onclick='toggleLike(" + c.id + ")'>" + liked + "</span></div>";
            html += "<div style='margin:10px 0'>" + c.text + "</div>";

            html += "<button class=btn onclick='replyToComment(" + c.id + ")'>Antworten</button>";
            html += "<button class=btn onclick='generateReply(" + c.id + ")'>✍️ Vorschlag</button>";
            html += "<div id='sugg-" + c.id + "'></div>";
            html += "</div>"; 
        });
                html = html || "<p>Keine Kommentare</p>";
                document.getElementById("yt-comments-content").innerHTML = html;
            });
        }

        function generateReplies() { document.getElementById("yt-comments-content").innerHTML = "<p>Generiere Vorschläge...</p>"; }
        
        function generateReply(commentId) {
            document.getElementById("sugg-" + commentId).innerHTML = "<p>Generiere...</p>";
            fetch("/api/youtube/comments/" + commentId + "/suggest", {method: "POST"}).then(r => r.json()).then(data => {
                let html = "<div style='margin:10px 0'>";
                if (data.suggestion1) {
                    html += "<button class=btn style='margin:2px' onclick='useReply(" + commentId + "," + JSON.stringify(data.suggestion1) + ")'>" + data.suggestion1 + "</button>";
                }
                if (data.suggestion2) {
                    html += "<button class=btn style='margin:2px' onclick='useReply(" + commentId + "," + JSON.stringify(data.suggestion2) + ")'>" + data.suggestion2 + "</button>";
                }
                html += " <button class=btn style='background:#666' onclick='loadYouTubeComments()'>X</button></div>";
                document.getElementById("sugg-" + commentId).innerHTML = html;
            });
        }
        
        function useReply(commentId, replyText) {
            fetch("/api/youtube/comments/" + commentId + "/reply", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({text: replyText})
            }).then(() => loadYouTubeComments());
        }
        
        function showReplyForm(commentId) {
            // Get comment data
            fetch("/api/youtube/comments").then(r => r.json()).then(data => {
                const c = data.comments.find(x => x.id === commentId);
                if (!c) return;
                
                // Generate suggestions - fill input field instead of sending
                fetch("/api/youtube/comments/" + commentId + "/suggest", {method: "POST"}).then(r => r.json()).then(sugg => {
                    let html = '<div style="background:rgba(0,255,136,0.1);padding:15px;margin:10px 0;border-radius:8px">';
                    html += '<div style="margin-bottom:10px"><strong>Antwort an ' + c.author_name + ':</strong></div>';
                    if (sugg.suggestion1) {
                        html += '<button class=btn style="margin:2px" onclick="fillReplyInput(' + commentId + ',\'' + sugg.suggestion1.replace(/'/g,"\\'") + '\')">' + sugg.suggestion1 + '</button>';
                    }
                    if (sugg.suggestion2) {
                        html += '<button class=btn style="margin:2px" onclick="fillReplyInput(' + commentId + ',\'' + sugg.suggestion2.replace(/'/g,"\\'") + '\')">' + sugg.suggestion2 + '</button>';
                    }
                    html += '<br><input type="text" id="reply-input-' + commentId + '" placeholder="Eigene Antwort..." style="width:80%;margin-top:10px;padding:8px">';
                    html += '<button class=btn style="margin:5px" onclick="sendReply(' + commentId + ',document.getElementById(\'reply-input-' + commentId + '\').value)">Senden</button>';
                    html += '<button class=btn style="background:#666" onclick="document.getElementById(\'reply-' + commentId + '\').innerHTML=\'\'">X</button>';
                    html += '</div>';
                    document.getElementById("reply-" + commentId).innerHTML = html;
                });
            });
        }
        
        function fillReplyInput(commentId, text) {
            const input = document.getElementById("reply-input-" + commentId);
            if (input) input.value = text;
        }
        
        function sendReply(commentId, text) {
            if (!text || text.trim() === "") return;
            fetch("/api/youtube/comments/" + commentId + "/reply", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({text: text})
            }).then(() => {
                document.getElementById("reply-" + commentId).innerHTML = "";
                loadYouTubeVIP();
            });
        }
        
        function toggleLike(commentId) {
            fetch("/api/youtube/comments/" + commentId + "/like", {method: "POST"}).then(r => r.json()).then(data => {
                if (data.status === 'success') {
                    // Update the button visually
                    const btn = document.querySelector('[onclick="toggleLike(' + commentId + ')"]');
                    if (btn) {
                        btn.textContent = '👍';
                        btn.style.color = '#00ff88';
                    }
                    loadYouTubeVIP();
                } else {
                    alert('Fehler: ' + (data.message || 'Unknown'));
                }
            }).catch(e => console.error('Like error:', e));
        }
        
        function skipComment(id) { loadYouTubeComments(); }

        function loadYouTube() {
            fetch('/api/youtube/stats/all').then(r => r.json()).then(data => {
                if (data.status === 'success' && data.channels) {
                    let html = '<table style="width:100%;border-collapse:collapse"><tr style="background:#333"><th style="padding:8px">Kanal</th><th>Type</th><th>Subs</th><th>Views</th><th>Videos</th><th>Updates</th></tr>';
                    data.channels.forEach(ch => {
                        html += `<tr style="border-bottom:1px solid #444">
                            <td style="padding:8px"><strong>${ch.channel_name}</strong></td>
                            <td>${ch.type}</td>
                            <td>${(ch.subscribers||0).toLocaleString()}</td>
                            <td>${(ch.total_views||0).toLocaleString()}</td>
                            <td>${ch.video_count||0}</td>
                            <td>${ch.updated_at ? new Date(ch.updated_at).toLocaleDateString('de-DE') : '-'}</td>
                        </tr>`;
                    });
                    html += '</table>';
                    document.getElementById('youtube-content').innerHTML = html;
                } else {
                    document.getElementById('youtube-content').innerHTML = 'Fehler: ' + (data.message || 'Unknown');
                }
            }).catch(e => document.getElementById('youtube-content').innerHTML = 'Error: ' + e);
        }
        
        function loadNews() {
            fetch('/api/news?limit=30').then(r => r.json()).then(data => {
                allNews = data.articles || [];
                renderNews(allNews);
            });
        }
        
        // Woke Filter State
        let wokeFilterActive = localStorage.getItem('wokeFilterActive') === 'true';
        
        // Initialize woke filter button on page load
        document.addEventListener('DOMContentLoaded', function() {
            if (wokeFilterActive) {
                const btn = document.getElementById('btn-woke-filter');
                if (btn) {
                    btn.style.background = '#ff6b6b';
                    btn.style.color = '#fff';
                    btn.style.borderColor = '#ff0000';
                }
            }
        });
        
        function toggleWokeFilter() {
            wokeFilterActive = !wokeFilterActive;
            localStorage.setItem('wokeFilterActive', wokeFilterActive);
            
            const btn = document.getElementById('btn-woke-filter');
            if (wokeFilterActive) {
                btn.style.background = '#ff6b6b';
                btn.style.color = '#fff';
                btn.style.borderColor = '#ff0000';
                // Fetch filtered news
                fetch('/api/news/woke-filter?active=true&limit=50').then(r => r.json()).then(data => {
                    if (data.status === 'success') {
                        allNews = data.articles || [];
                        renderNews(allNews);
                        console.log('Woke Filter: Found', data.count, 'articles');
                        console.log('Query Performance:', data.explain);
                    }
                }).catch(e => console.error('Woke filter error:', e));
            } else {
                btn.style.background = '';
                btn.style.color = '';
                btn.style.borderColor = '#666';
                // Reload normal news
                loadNews();
            }
        }

        function loadTasks(extraParams = '') {
            const category = document.getElementById('task-category-filter')?.value || 'all';
            const params = extraParams || (category !== 'all' ? `?category=${category}` : '');
            fetch('/api/tasks' + params).then(r => r.json()).then(data => {
                const total = data.counts.todo + data.counts.in_progress + data.counts.awaiting_confirm + data.counts.done;
                document.getElementById('task-count').textContent = total;
                ['todo', 'in-progress', 'awaiting-confirm', 'done'].forEach(status => {
                    const container = document.getElementById('tasks-' + status);
                    const tasks = data.tasks[status.replace('-', '_')] || [];
                    container.innerHTML = tasks.map(t => `
                        <div class="task-card" draggable="true" ondragstart="drag(event)" draggable="true" ondragstart="drag(event)" ondragstart="drag(event)" draggable="true" ondragstart="drag(event)" data-id=" style="${t.archived ? 'opacity:0.6' : ''}">
                            <span class="task-priority priority-${t.priority}">P${t.priority}</span>
                            ${t.category ? `<span style="font-size:0.7em;background:#333;padding:2px 6px;border-radius:4px;margin-left:5px">${t.category}</span>` : ''}
                            <div><strong><a href="${t.url || '#'}" style="color: inherit; text-decoration: none;">${t.title}</a></strong></div>
                            <div style="color: #888; font-size: 1.2em; margin-top: 5px;">${t.description || ''}</div>
                            <div class="task-actions">
                                ${!t.archived ? `<button class="btn" style="padding: 4px 8px; font-size: 0.7em;" onclick="archiveTask(${t.id})">📦</button>` : ''}
                                <button class="btn" style="padding: 4px 8px; font-size: 0.7em;" onclick="openTaskModal(${t.id})">✏️</button>
                                <button class="btn btn-danger" style="padding: 4px 8px; font-size: 0.7em;" onclick="deleteTask(${t.id})">🗑️</button>
                            </div>
                        </div>
                    `).join('');
                });
            });
        }
        
        function drag(ev){ev.dataTransfer.setData("text",ev.target.closest(".task-card").dataset.id)}
function allowDrop(ev){ev.preventDefault()}
function drop(ev){ev.preventDefault();var t=ev.dataTransfer.getData("text"),s=ev.target.closest("[id^=tasks-]").id.replace("tasks-","");if(t&&s)fetch("/api/tasks/"+t,{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:s})}).then(()=>loadTasks())}

function archiveTask(id) {
            fetch(`/api/tasks/${id}/archive`, { method: 'POST' }).then(() => loadTasks());
        }

        // Clock
        setInterval(updateTime, 1000);

        // === DARK/LIGHT MODE ===
        function toggleTheme() {
            const html = document.documentElement;
            const toggle = document.getElementById('theme-toggle');
            const current = html.getAttribute('data-theme');
            const newTheme = current === 'light' ? 'dark' : 'light';
            
            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            toggle.textContent = newTheme === 'light' ? '☀️' : '🌙';
        }
        
        function initTheme() {
            const saved = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', saved);
            document.getElementById('theme-toggle').textContent = saved === 'light' ? '☀️' : '🌙';
        }
        
        // Initialize theme on load
        initTheme();

        // Initial Load
        loadDemos();
        loadTasks();
        loadPrices();
        loadOpenClawStats();
        loadTopModels();
        loadTopAgents();
                loadRheingoldLive();
        loadTopTools();
        loadSystemHealth();
        updateTime();  // Set initial time
        loadNews();
        showYouTubeSubtab('stats');
        loadAgents();  // Load agent status
        loadDashboardLogs();
        
        // Load prices every 30 seconds
        setInterval(loadPrices, 60000);

        // === DASHBOARD LOGS WIDGET ===
        function loadDashboardLogs() {
            fetch('/api/logs?limit=50').then(function(r){ return r.json(); }).then(function(logs) {
                var emojiMap = {
                    'metamaus':'🐭','zerberus':'🛡','rheingold':'🔍',
                    'hermes':'📡','hestia':'💬','orpheus':'🎵','athena':'🏛'
                };
                var logList = document.getElementById('log-list');
                var logCount = document.getElementById('log-count');
                if(logCount) logCount.textContent = logs.length;
                if(!logList) return;
                if(logs.length === 0) {
                    logList.innerHTML = '<div style="color:#555;font-size:18px;padding:8px">Keine Logs</div>';
                    return;
                }
                var html = '';
                for(var i=0; i<logs.length; i++) {
                    var l = logs[i];
                    var agent = (l.agent || '').toLowerCase();
                    var emoji = emojiMap[agent] || '🤖';
                    var zeit = l.timestamp ? new Date(l.timestamp).toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'}) : '--:--';
                    var lvlColor = l.level==='error' ? '#ff4444' : l.level==='warning' ? '#ffa500' : '#EAB308';
                    var msg = (l.message || '').substring(0, 55).replace(/</g,'&lt;').replace(/>/g,'&gt;');
                    html += '<div style="display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:4px;font-size:18px;border-left:2px solid ' + lvlColor + '">';
                    html += '<span style="font-size:17px">' + emoji + '</span>';
                    html += '<span style="color:#EAB308;font-weight:700;min-width:75px">' + (l.agent||'-') + '</span>';
                    html += '<span style="color:#888;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + msg + '</span>';
                    html += '<span style="color:#555;font-size:17px;white-space:nowrap">' + zeit + '</span>';
                    html += '</div>';
                }
                logList.innerHTML = html;
            }).catch(function(e){ console.error('Dashboard logs error:', e); });
        }
        setInterval(loadDashboardLogs, 30000);

        
        // AGENT FUNCTIONS
        function loadAgents() {
            // Load agents list dynamically from DB
            fetch('/api/agents').then(r => r.json()).then(data => {
                const container = document.getElementById('agents-grid');
                if (!data.agents || data.agents.length === 0) {
                    container.innerHTML = '<div style="color:#888">Keine Agenten gefunden</div>';
                    return;
                }
                
                // Emoji/Color map for agents
                const emojiMap = {
                    'zerberus': '🔐', 'orpheus': '🔑', 'athena': '📈', 
                    'metamaus': '🐭', 'hermes': '📡', 'rheingold': '🦅', 
                    'hestia': '🔥', 'apollon': '🛠️', 'pythia': '👁️'
                };
                const colorMap = {
                    'zerberus': '#00ff88', 'orpheus': '#ffd700', 'athena': '#00bfff',
                    'metamaus': '#ff9d00', 'hermes': '#a855f7', 'rheingold': '#ff4757',
                    'hestia': '#ff6b6b', 'apollon': '#00ff88', 'pythia': '#ff00ff'
                };
                
                container.innerHTML = data.agents.map(agent => {
                    const emoji = emojiMap[agent.name.toLowerCase()] || '🤖';
                    const color = colorMap[agent.name.toLowerCase()] || '#888';
                    const statusBadge = agent.status === 'active' ? '✅ ACTIVE' : '❌ INACTIVE';
                    return `
                        <div style="background:linear-gradient(135deg,#1a1a2e,#16213e);padding:20px;border-radius:12px;border:1px solid ${color}">
                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:15px">
                                <span style="font-size:28px">${emoji}</span>
                                <div>
                                    <strong style="color:${color};font-size:18px">${agent.name.toUpperCase()}</strong>
                                    <div style="color:#888;font-size:18px">${agent.description || ''}</div>
                                </div>
                                <span style="margin-left:auto;background:${color};color:#000;padding:4px 10px;border-radius:20px;font-size:17px;font-weight:bold">${statusBadge}</span>
                            </div>
                            <div style="color:#ccc;font-size:20px;margin-bottom:10px">
                                <div>📊 Status: <span style="color:${color}">${agent.status}</span></div>
                                <div>🕐 Last active: ${agent.last_active ? new Date(agent.last_active).toLocaleString('de-DE') : 'N/A'}</div>
                            </div>
                            <button class="btn" onclick="agentAction('${agent.name.toLowerCase()}','report')">📊 Report</button>
                        </div>
                    `;
                }).join('');
            }).catch(e => {
                console.log('Agent list unavailable:', e);
                document.getElementById('agents-grid').innerHTML = '<div style="color:#ff4444">Fehler beim Laden der Agenten</div>';
            });
            
            // Also fetch stats for dynamic updates
            fetch('/api/agents/status').then(r => r.json()).then(data => {
                // Stats werden hier geladen wenn benötigt
            }).catch(e => console.log('Agent status unavailable:', e));
        }
        
        function agentAction(agent, action) {
            if (action === 'stop' && !confirm('Emergency stop für ALLE Agenten?')) return;
            
            if (action === 'report') {
                // Show report in modal
                fetch('/api/agents/' + agent + '/report').then(r => r.json()).then(data => {
                    if (data.error) {
                        alert('Error: ' + data.error);
                    } else {
                        document.getElementById('report-content').innerHTML = data.report;
                        document.getElementById('report-modal').style.display = 'block';
                    }
                }).catch(e => alert('Error: ' + e));
                return;
            }
            
            fetch('/api/agents/' + agent + '/' + action, {method: 'POST'}).then(r => r.json()).then(data => {
                const toast = document.getElementById('notification-toast');
                toast.textContent = agent.toUpperCase() + ': ' + (data.message || data.status);
                toast.style.display = 'block';
                setTimeout(() => toast.style.display = 'none', 3000);
                if (action === 'refresh') loadAgents();
            }).catch(e => {
                const toast = document.getElementById('notification-toast');
                toast.textContent = 'Error: ' + e;
                toast.style.background = '#ff4757';
                toast.style.borderColor = '#ff4757';
                toast.style.display = 'block';
                setTimeout(() => { 
                    toast.style.display = 'none'; 
                    toast.style.background = '#1a1a2e';
                    toast.style.borderColor = '#00ff88';
                }, 3000);
            });
        }
        
        // ============ NETWORK TAB FUNCTIONS ============
        function loadNetworkDevices() {
            fetch('/api/network/devices')
            .then(r => r.json())
            .then(devices => {
                const container = document.getElementById('network-devices-container');
                if (!devices || devices.length === 0) {
                    container.innerHTML = '<div style="color:#888;grid-column:1/-1;">Keine Geräte gefunden. Starte einen Netzwerk-Scan!</div>';
                    return;
                }
                container.innerHTML = devices.map(d => `
                    <div class="device-card" onclick="showNetworkDevice('${d.ip}')">
                        <div class="card-ip">${d.ip}</div>
                        <div class="card-host">${d.hostname || 'unknown'}</div>
                        <div class="${d.status?.toLowerCase() === 'up' || d.status?.toLowerCase() === 'online' ? 'status-online' : 'status-offline'}">
                            ${d.status?.toLowerCase() === 'up' || d.status?.toLowerCase() === 'online' ? '🟢 ONLINE' : '🔴 OFFLINE'}
                        </div>
                        <div style="margin-top:8px;color:#666;font-size:0.85em">${d.device_type || '?'}</div>
                        <div class="card-vendor">${d.vendor || '-'}</div>
                        <div class="card-mac">MAC: ${d.mac_address ? d.mac_address.substring(0,8) + '...' : '-'}</div>
                        <div class="card-ports">${d.open_ports ? 'Ports: ' + d.open_ports : 'Ports: None'}</div>
                        ${d.notes ? `<div class="card-notes">Notes: ${d.notes.substring(0,30)}${d.notes.length > 30 ? '...' : ''}</div>` : ''}
                    </div>
                `).join('');
            })
            .catch(err => console.error('Network fetch error:', err));
        }

        // Event delegation for device cards (works even after innerHTML rebuild)
        document.addEventListener('click', function(e) {
            const card = e.target.closest('.device-card');
            if (card && document.getElementById('network').classList.contains('active')) {
                const ipEl = card.querySelector('.card-ip');
                if (ipEl) {
                    const ip = ipEl.textContent.trim();
                    console.log('Delegated click on card:', ip);
                    showNetworkDevice(ip);
                }
            }
        });

        function showNetworkDevice(ip) {
            console.log('Opening modal for IP:', ip);
            fetch(`/api/network/device/${ip}`)
            .then(r => r.json())
            .then(d => {
                document.getElementById('network-modal-title').textContent = `${d.ip} – ${d.hostname || 'Unknown'}`;
                document.getElementById('network-modal-body').innerHTML = `
                    <p><b>Status:</b> ${d.status}</p>
                    <p><b>Type:</b> ${d.device_type || '-'}</p>
                    <p><b>MAC (full):</b> ${d.mac_address || '-'}</p>
                    <p><b>Vendor:</b> ${d.vendor || '-'}</p>
                    <p><b>Open Ports:</b> ${d.open_ports || 'None'}</p>
                    <p><b>First Seen:</b> ${d.first_seen || '-'}</p>
                    <p><b>Last Seen:</b> ${d.last_seen || '-'}</p>
                    <p><b>Notes (full):</b><br>
                    <textarea id="network-notes-text" rows="4" style="width:100%; background:#1a1f2e; color:#e0e0ff; border:1px solid #00ff9d;">${d.notes || ''}</textarea></p>
                    <button onclick="saveNetworkNotes('${d.ip}')" style="margin-top:10px; padding:8px 16px; background:#00ff9d; color:black; border:none; border-radius:6px; cursor:pointer;">Save Notes</button>
                `;
                document.getElementById('network-modal').style.display = 'flex';
            });
        }

        function saveNetworkNotes(ip) {
            const notes = document.getElementById('network-notes-text').value;
            fetch('/api/network/update', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ip: ip, notes: notes})
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert('Notes saved successfully!');
                    document.getElementById('network-modal').style.display = 'none';
                    loadNetworkDevices();
                } else {
                    alert('Error: ' + (data.error || 'Unknown'));
                }
            })
            .catch(err => alert('Save failed: ' + err));
        }

        // Close modal on outside click
        document.getElementById('network-modal')?.addEventListener('click', function(e) {
            if (e.target === this) this.style.display = 'none';
        });
        
        // ============ MAILS TAB FUNCTIONS ============
        function loadMails(filter) {
            const url = '/api/rheingold/mails' + (filter && filter !== 'all' ? '?status=' + filter : '');
            fetch(url)
            .then(r => {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(mails => {
                const tbody = document.getElementById('mails-tbody');
                if (mails.error) {
                    tbody.innerHTML = '<tr><td colspan="6" style="padding:20px;color:#ff4444;">Fehler: ' + mails.error + '</td></tr>';
                    return;
                }
                if (!mails || mails.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" style="padding: 20px; text-align: center; color: #888;">Keine Mails gefunden</td></tr>';
                    return;
                }
                tbody.innerHTML = mails.map(m => `
                    <tr onclick="openMailModal(${m.id})" style="cursor: pointer; border-bottom: 1px solid #222;">
                        <td style="padding: 10px;">${m.ifg_request_id ? '<span style="background:#00ff9d;color:black;padding:2px 6px;border-radius:3px;font-weight:bold;">#' + m.ifg_request_id + '</span>' : '<span style="color:#666;">-</span>'}</td>
                        <td style="padding: 10px;">${m.an}</td>
                        <td style="padding: 10px;">${m.betreff}</td>
                        <td style="padding: 10px;" class="status-${m.status}">${m.status}</td>
                        <td style="padding: 10px;">${m.erstellt_am ? new Date(m.erstellt_am).toLocaleDateString('de-DE') : '-'}</td>
                        <td style="padding: 10px;">
                            <button onclick="event.stopPropagation(); openMailModal(${m.id})" style="padding: 5px 10px; background: #00ff9d; color: black; border: none; border-radius: 3px;">✏️</button>
                        </td>
                    </tr>
                `).join('');
                const drafts = mails.filter(m => m.status === 'entwurf' || m.status === 'bereit').length;
                document.getElementById('mail-counter').textContent = drafts;
            })
            .catch(err => {
                const tbody = document.getElementById('mails-tbody');
                tbody.innerHTML = '<tr><td colspan="6" style="padding:20px;color:#ff4444;">⚠️ API nicht erreichbar: ' + err.message + '</td></tr>';
                console.error('loadMails error:', err);
            });
        }
        
        // Auto-load mails on page load if mails tab is active
        document.addEventListener('DOMContentLoaded', function() {
            if (document.getElementById('mails') && document.getElementById('mails').classList.contains('active')) {
                loadMails('all');
            }
        });

        // ============ LOGS FUNCTIONS ============
        // Global filter state
        let logFilters = { agent: '', level: '' };
        
        function filterLogs(type, value) {
            logFilters[type] = value;
            
            // Update button states
            document.querySelectorAll('.log-btn').forEach(btn => btn.classList.remove('active'));
            if (type === 'agent') {
                const btnId = value ? 'btn-' + value.toLowerCase() : 'btn-all';
                const btn = document.getElementById(btnId);
                if (btn) btn.classList.add('active');
            }
            
            loadLogs();
        }
        
        function loadLogs() {
            let url = '/api/logs';
            const params = new URLSearchParams();
            if (logFilters.agent) params.append('agent', logFilters.agent);
            if (logFilters.level) params.append('level', logFilters.level);
            if (params.toString()) url += '?' + params.toString();
            
            fetch(url)
            .then(r => r.json())
            .then(logs => {
                const tbody = document.getElementById('logs-tbody');
                if (!tbody) return;
                if (!logs || logs.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" style="padding: 20px; text-align: center; color: #888;">Keine Logs gefunden</td></tr>';
                    return;
                }
                tbody.innerHTML = logs.map(l => `
                    <tr style="border-bottom: 1px solid #222;">
                        <td style="padding: 8px; font-size: 12px; color: #888;">${l.timestamp ? new Date(l.timestamp).toLocaleString('de-DE') : '-'}</td>
                        <td style="padding: 8px;"><span style="background: #333; padding: 2px 8px; border-radius: 3px;">${l.agent || '-'}</span></td>
                        <td style="padding: 8px;" class="level-${l.level}">${l.level || '-'}</td>
                        <td style="padding: 8px; font-family: monospace; font-size: 12px;">${l.message || ''}</td>
                    </tr>
                `).join('');
                const counterEl = document.getElementById('log-counter');
                if (counterEl) counterEl.textContent = logs.length;
            })
            .catch(err => {
                const errEl = document.getElementById('logs-tbody');
                if (errEl) errEl.innerHTML = '<tr><td colspan="4" style="padding:20px;color:#ff4444;">⚠️ Fehler: ' + err.message + '</td></tr>';
            });
        }

        function openMailModal(id) {
            console.log('Opening mail modal for ID:', id);
            fetch('/api/rheingold/mail/' + id)
            .then(r => {
                console.log('Mail fetch status:', r.status);
                return r.json();
            })
            .then(m => {
                document.getElementById('mail-id').value = m.id;
                document.getElementById('mail-to').value = m.an;
                document.getElementById('mail-subject').value = m.betreff;
                // NO auto-signature: show exactly what is in the DB
                document.getElementById('mail-body').value = m.text_final || m.text_entwurf || '';
                document.getElementById('mail-modal').style.display = 'flex';
            });
        }

        function saveMail() {
            const id = document.getElementById('mail-id').value;
            const toEmail = document.getElementById('mail-to').value;

            // Email-Validierung
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(toEmail)) {
                alert('❌ Ungültige Email-Adresse! Format: name@domain.de');
                return;
            }

            fetch('/api/rheingold/mail/' + id, {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    an: toEmail,
                    betreff: document.getElementById('mail-subject').value,
                    text_final: document.getElementById('mail-body').value
                })
            })
            .then(r => r.json())
            .then(data => {
                alert('💾 Gespeichert!');
                loadMails('all');
                document.getElementById('mail-modal').style.display = 'none';
            });
        }

        function sendMail() {
            const toEmail = document.getElementById('mail-to').value;

            // Email-Validierung
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(toEmail)) {
                alert('❌ Ungültige Email-Adresse! Format: name@domain.de');
                return;
            }

            if (!confirm('M wirklich SENDEN?')) return;
            const id = document.getElementById('mail-id').value;
            fetch('/api/rheingold/mail/send/' + id, {method: 'POST'})
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert('✅ Gesendet am ' + new Date(data.sent_at).toLocaleString('de-DE'));
                    loadMails('all');
                    document.getElementById('mail-modal').style.display = 'none';
                } else {
                    alert('❌ Fehler: ' + (data.error || 'Unbekannt'));
                }
            })
            .catch(err => alert('❌ Netzwerk-Fehler: ' + err));
        }

        function deleteMail() {
            if (!confirm('M wirklich LÖSCHEN?')) return;
            const id = document.getElementById('mail-id').value;
            fetch('/api/rheingold/mail/' + id, {method: 'DELETE'})
            .then(r => r.json())
            .then(data => {
                alert('🗑 Gelöscht');
                loadMails('all');
                document.getElementById('mail-modal').style.display = 'none';
            });
        }

        // Close mail modal on outside click
        document.getElementById('mail-modal')?.addEventListener('click', function(e) {
            if (e.target === this) this.style.display = 'none';
        });

        // RHEINGOLD TAB LOADER
);
                rheingoldLoaded = true;
            } catch(e) {
                frame.innerHTML = '<div style="text-align:center;padding:60px;color:#ef4444;font-family:monospace">Fehler: ' + e.message + '</div>';
            }
        }
    </script>
</body>
</html>