                    <script>
// Load DB Stats
async function loadDBStats() {
    try {
        const stats = await fetch("/api/db/stats").then(r => r.json());
        document.getElementById("db-findings").textContent = stats.findings?.toLocaleString() || 0;
        document.getElementById("db-actors").textContent = stats.actors?.toLocaleString() || 0;
        document.getElementById("db-entities").textContent = stats.entities?.toLocaleString() || 0;
        document.getElementById("db-24h").textContent = "+" + (stats.findings_24h || 0);
        
        // Update dashboard tiles
        if (document.getElementById("db-size")) {
            document.getElementById("db-size").textContent = (stats.db_size_mb || 59) + " MB";
        }
        if (document.getElementById("db-growth")) {
            const growth24h = stats.findings_24h || 0;
            const growth7d = stats.findings_7d || 0;
            document.getElementById("db-growth").textContent = "+" + growth24h + " heute · +" + growth7d + " gesamt";
        }
        
        // Load recent logs
        loadRecentLogs();
    } catch(e) { console.error("DB Stats error:", e); }
}

async function loadRecentLogs() {
    try {
        const logs = await fetch("/api/logs?limit=5").then(r => r.json());
        if (document.getElementById("log-count")) {
            document.getElementById("log-count").textContent = logs.length + " Einträge";
        }
        
        // Render log list
        const logList = document.getElementById("log-list");
        if (logList) {
            const emojiMap = {
                'metamaus': '🐭', 'zerberus': '🛡', 'rheingold': '🔍',
                'hermes': '📡', 'hestia': '💬', 'orpheus': '🎵', 'athena': '📈'
            };
            logList.innerHTML = logs.map(l => {
                const emoji = emojiMap[l.agent?.toLowerCase()] || '🤖';
                const zeit = l.timestamp ? new Date(l.timestamp).toLocaleTimeString('de-DE', {hour:'2-digit',minute:'2-digit'}) : '--:--';
                const levelClass = l.level === 'warning' ? 'log-level-warning' : l.level === 'error' ? 'log-level-error' : 'log-level-info';
                const levelLabel = l.level === 'warning' ? 'WARN' : l.level === 'error' ? 'ERR' : 'INFO';
                return `<div class="log-row" onclick="showLog('${(l.message||'').replace(/'/g,"\\'")}')" style="display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:4px;cursor:pointer;font-size:12px" onmouseover="this.style.background='rgba(74,222,128,0.08)'" onmouseout="this.style.background='transparent'">
                    <span style="font-size:14px">${emoji}</span>
                    <span style="color:#4ade80;font-weight:700;min-width:70px">${l.agent || '-'}</span>
                    <span style="color:#475569;font-size:11px;margin-left:auto">${zeit}</span>
                    <span style="font-size:9px;letter-spacing:1px;padding:2px 5px;border-radius:3px;background:rgba(34,211,238,0.1);color:#22d3ee">${levelLabel}</span>
                </div>`;
            }).join('');
        }
    } catch(e) { console.error("Logs error:", e); }
}

function showLog(msg) {
    document.getElementById('log-modal-text').textContent = msg;
    document.getElementById('log-modal').style.display = 'flex';
}
loadDBStats();
setInterval(loadDBStats, 60000);

                    async function loadFreqtradeData() {
                        try {
                            const [profit, status, balance, perf] = await Promise.all([
                                fetch('/api/freqtrade/profit').then(r=>r.json()),
                                fetch('/api/freqtrade/status').then(r=>r.json()),
                                fetch('/api/freqtrade/balance').then(r=>r.json()),
                                fetch('/api/freqtrade/performance').then(r=>r.json())
                            ]);
                            
                            // Status
                            document.getElementById('ft-status').textContent = '✅ Running';
                            
                            // P&L
                            const pnl = profit.profit_closed_percent_sum || 0;
                            const pnlEl = document.getElementById('ft-pnl-pct');
                            pnlEl.textContent = (pnl > 0 ? '+' : '') + pnl.toFixed(2) + '%';
                            pnlEl.style.color = pnl >= 0 ? '#00ff88' : '#ff4444';
                            
                            // Trades + Win Rate
                            document.getElementById('ft-trades').textContent = profit.trade_count || 0;
                            const wr = profit.winrate ? (profit.winrate*100).toFixed(1)+'%' : '--';
                            document.getElementById('ft-winrate').textContent = wr;
                            
                            // Balance
                            if (balance?.total) {
                                document.getElementById('ft-balance').textContent = '$' + parseFloat(balance.total).toFixed(2);
                            }
                            
                            // Pairs from status
                            if (Array.isArray(status) && status.length > 0) {
                                const pairs = [...new Set(status.map(t=>t.pair))];
                                document.getElementById('ft-pairs').textContent = pairs.join(', ');
                            } else {
                                document.getElementById('ft-pairs').textContent = 'Keine offenen Trades';
                            }
                            
                            // Winner / Loser
                            if (Array.isArray(perf) && perf.length > 0) {
                                const sorted = [...perf].sort((a,b)=>b.profit_pct-a.profit_pct);
                                const winners = sorted.filter(p=>p.profit_pct>0).slice(0,5);
                                const losers = [...sorted].reverse().filter(p=>p.profit_pct<0).slice(0,5);
                                
                                document.getElementById('ft-winners').innerHTML = winners.length ? winners.map(p=>`<tr><td>${p.pair}</td><td style="color:#00ff88">+${p.profit_pct.toFixed(2)}%</td><td style="color:#00ff88">$${p.profit_abs.toFixed(2)}</td></tr>`).join('') : '<tr><td colspan="3" style="color:#666">Keine Daten</td></tr>';
                                
                                document.getElementById('ft-losers').innerHTML = losers.length ? losers.map(p=>`<tr><td>${p.pair}</td><td style="color:#ff4444">${p.profit_pct.toFixed(2)}%</td><td style="color:#ff4444">$${p.profit_abs.toFixed(2)}</td></tr>`).join('') : '<tr><td colspan="3" style="color:#666">Keine Daten</td></tr>';
                            }
                        } catch(e) {
                            console.error('Freqtrade Fehler:', e);
                            document.getElementById('ft-status').textContent = '❌ Offline';
                            document.getElementById('ft-status').style.color = '#ff4444';
                        }
                    }
