            fetch('/api/demos?category=' + currentDemoFilter)
                .then(r => r.json())
                .then(data => {
                    let events = data.events || [];
                    if (location !== 'all') {
                        events = events.filter(e => (e.location || '').toLowerCase().includes(location.toLowerCase()));
                    }
                    renderDemos(events);
                });
