        });

        function showNetworkDevice(ip) {
            console.log('Opening modal for IP:', ip);
            fetch(`/api/network/device/${ip}`)
            .then(r => r.json())
            .then(d => {
                document.getElementById('network-modal-title').textContent = `${d.ip} – ${d.hostname || 'Unknown'}`;
                document.getElementById('network-modal-body').innerHTML = `
                    <p><b>Status:</b> ${d.status}</p>
                    <p><b>Type:</b> ${d.device_type || '-'}</p>
                    <p><b>MAC (full):</b> ${d.mac_address || '-'}</p>
                    <p><b>Vendor:</b> ${d.vendor || '-'}</p>
                    <p><b>Open Ports:</b> ${d.open_ports || 'None'}</p>
                    <p><b>First Seen:</b> ${d.first_seen || '-'}</p>
                    <p><b>Last Seen:</b> ${d.last_seen || '-'}</p>
                    <p><b>Notes (full):</b><br>
                    <textarea id="network-notes-text" rows="4" style="width:100%; background:#1a1f2e; color:#e0e0ff; border:1px solid #00ff9d;">${d.notes || ''}</textarea></p>
                    <button onclick="saveNetworkNotes('${d.ip}')" style="margin-top:10px; padding:8px 16px; background:#00ff9d; color:black; border:none; border-radius:6px; cursor:pointer;">Save Notes</button>
                `;
                document.getElementById('network-modal').style.display = 'flex';
            });
        }

        function saveNetworkNotes(ip) {
            const notes = document.getElementById('network-notes-text').value;
            fetch('/api/network/update', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ip: ip, notes: notes})
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert('Notes saved successfully!');
                    document.getElementById('network-modal').style.display = 'none';
                    loadNetworkDevices();
                } else {
                    alert('Error: ' + (data.error || 'Unknown'));
                }
            })
            .catch(err => alert('Save failed: ' + err));
        }

        // Close modal on outside click
        document.getElementById('network-modal')?.addEventListener('click', function(e) {
            if (e.target === this) this.style.display = 'none';
        });
        
        // ============ MAILS TAB FUNCTIONS ============
        function loadMails(filter) {
            const url = '/api/rheingold/mails' + (filter && filter !== 'all' ? '?status=' + filter : '');
            fetch(url)
            .then(r => {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(mails => {
                const tbody = document.getElementById('mails-tbody');
                if (mails.error) {
                    tbody.innerHTML = '<tr><td colspan="5" style="padding:20px;color:#ff4444;">Fehler: ' + mails.error + '</td></tr>';
                    return;
                }
                if (!mails || mails.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" style="padding: 20px; text-align: center; color: #888;">Keine Mails gefunden</td></tr>';
                    return;
                }
                tbody.innerHTML = mails.map(m => `
                    <tr onclick="openMailModal(${m.id})" style="cursor: pointer; border-bottom: 1px solid #222;">
                        <td style="padding: 10px;">${m.an}</td>
                        <td style="padding: 10px;">${m.betreff}</td>
                        <td style="padding: 10px;" class="status-${m.status}">${m.status}</td>
                        <td style="padding: 10px;">${m.erstellt_am ? new Date(m.erstellt_am).toLocaleDateString('de-DE') : '-'}</td>
                        <td style="padding: 10px;">
                            <button onclick="event.stopPropagation(); openMailModal(${m.id})" style="padding: 5px 10px; background: #00ff9d; color: black; border: none; border-radius: 3px;">✏️</button>
                        </td>
                    </tr>
                `).join('');
                const drafts = mails.filter(m => m.status === 'entwurf' || m.status === 'bereit').length;
                document.getElementById('mail-counter').textContent = drafts;
            })
            .catch(err => {
                const tbody = document.getElementById('mails-tbody');
                tbody.innerHTML = '<tr><td colspan="5" style="padding:20px;color:#ff4444;">⚠️ API nicht erreichbar: ' + err.message + '</td></tr>';
                console.error('loadMails error:', err);
            });
        }
        
        // Auto-load mails on page load if mails tab is active
        document.addEventListener('DOMContentLoaded', function() {
            if (document.getElementById('mails') && document.getElementById('mails').classList.contains('active')) {
                loadMails('all');
            }
        });

        // ============ LOGS FUNCTIONS ============
        // Global filter state
        let logFilters = { agent: '', level: '' };
        
        function filterLogs(type, value) {
            logFilters[type] = value;
            
            // Update button states
            document.querySelectorAll('.log-btn').forEach(btn => btn.classList.remove('active'));
            if (type === 'agent') {
                const btnId = value ? 'btn-' + value.toLowerCase() : 'btn-all';
                const btn = document.getElementById(btnId);
                if (btn) btn.classList.add('active');
            }
            
            loadLogs();
        }
        
        function loadLogs() {
            let url = '/api/logs';
            const params = new URLSearchParams();
            if (logFilters.agent) params.append('agent', logFilters.agent);
            if (logFilters.level) params.append('level', logFilters.level);
            if (params.toString()) url += '?' + params.toString();
            
            fetch(url)
            .then(r => r.json())
            .then(logs => {
                const tbody = document.getElementById('logs-tbody');
                if (!tbody) return;
                if (!logs || logs.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" style="padding: 20px; text-align: center; color: #888;">Keine Logs gefunden</td></tr>';
                    return;
                }
                tbody.innerHTML = logs.map(l => `
                    <tr style="border-bottom: 1px solid #222;">
                        <td style="padding: 8px; font-size: 12px; color: #888;">${l.timestamp ? new Date(l.timestamp).toLocaleString('de-DE') : '-'}</td>
                        <td style="padding: 8px;"><span style="background: #333; padding: 2px 8px; border-radius: 3px;">${l.agent || '-'}</span></td>
                        <td style="padding: 8px;" class="level-${l.level}">${l.level || '-'}</td>
                        <td style="padding: 8px; font-family: monospace; font-size: 12px;">${l.message || ''}</td>
                    </tr>
                `).join('');
                const counterEl = document.getElementById('log-counter');
                if (counterEl) counterEl.textContent = logs.length;
            })
            .catch(err => {
                const errEl = document.getElementById('logs-tbody');
                if (errEl) errEl.innerHTML = '<tr><td colspan="4" style="padding:20px;color:#ff4444;">⚠️ Fehler: ' + err.message + '</td></tr>';
            });
        }

        function openMailModal(id) {
            console.log('Opening mail modal for ID:', id);
            fetch('/api/rheingold/mail/' + id)
            .then(r => {
                console.log('Mail fetch status:', r.status);
                return r.json();
            })
            .then(m => {
                document.getElementById('mail-id').value = m.id;
                document.getElementById('mail-to').value = m.an;
                document.getElementById('mail-subject').value = m.betreff;
                document.getElementById('mail-body').value = m.text_final || m.text_entwurf;
                document.getElementById('mail-modal').style.display = 'flex';
            });
        }

        function saveMail() {
            const id = document.getElementById('mail-id').value;
            fetch('/api/rheingold/mail/' + id, {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    an: document.getElementById('mail-to').value,
                    betreff: document.getElementById('mail-subject').value,
                    text_final: document.getElementById('mail-body').value
                })
            })
            .then(r => r.json())
            .then(data => {
                alert('💾 Gespeichert!');
                loadMails('all');
                document.getElementById('mail-modal').style.display = 'none';
            });
        }

        function sendMail() {
            if (!confirm('M wirklich SENDEN?')) return;
            const id = document.getElementById('mail-id').value;
            fetch('/api/rheingold/mail/send/' + id, {method: 'POST'})
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert('✅ Gesendet am ' + new Date(data.sent_at).toLocaleString('de-DE'));
                    loadMails('all');
                    document.getElementById('mail-modal').style.display = 'none';
                } else {
                    alert('❌ Fehler: ' + (data.error || 'Unbekannt'));
                }
            })
            .catch(err => alert('❌ Netzwerk-Fehler: ' + err));
        }

        function deleteMail() {
            if (!confirm('M wirklich LÖSCHEN?')) return;
            const id = document.getElementById('mail-id').value;
            fetch('/api/rheingold/mail/' + id, {method: 'DELETE'})
            .then(r => r.json())
            .then(data => {
                alert('🗑 Gelöscht');
                loadMails('all');
                document.getElementById('mail-modal').style.display = 'none';
            });
        }

        // Close mail modal on outside click
        document.getElementById('mail-modal')?.addEventListener('click', function(e) {
            if (e.target === this) this.style.display = 'none';
        });
    
        let rheingoldLoaded = false;
        async function loadRheingoldTab() {
            var frame = document.getElementById('rheingold-frame');
            if (!frame || rheingoldLoaded) return;
            frame.innerHTML = '<div style="padding:40px;color:#64748b;text-align:center">Lade...</div>';
            try {
                var r = await fetch('/rheingold/content');
                var html = await r.text();
                frame.innerHTML = html;
                frame.querySelectorAll('script').forEach(function(s) {
                    var n = document.createElement('script');
                    n.textContent = s.textContent;
                    document.body.appendChild(n);
                    s.remove();
                });
                rheingoldLoaded = true;
            } catch(e) {
                frame.innerHTML = '<div style="padding:40px;color:#ef4444">Fehler: ' + e.message + '</div>';
            }
        }
</script>
</body>
</html>